#!/usr/bin/env bash
# omalexia-focus: reading mode for the focused window.
#
# Tiled windows on a wide monitor become very long lines of text, which is
# hard to read for dyslexic readers (the BDA recommends 60–70 characters per
# line). Reading mode floats the focused window at a comfortable reading
# width, centred on its monitor, and tucks the other windows of the same
# workspace into a special workspace so the reader faces one clean window.
# Run it again to undo everything: the hidden windows come back and the
# window returns to its previous place, exact geometry if it was floating,
# back into the tiling layout on its original workspace if it was tiled.
#
# Usage: omalexia-focus [toggle|on|off|status] [window-address]
#
# Omarchy's Hyprland uses the Lua config provider, so `hyprctl dispatch`
# takes Lua (hl.dsp.*) rather than the classic "setfloating address:…" form.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omalexia/focus"
MAX_WIDTH="${OMALEXIA_READING_WIDTH:-1100}" # logical pixels
WIDTH_FRACTION="${OMALEXIA_READING_FRACTION:-0.60}"
HEIGHT_FRACTION="${OMALEXIA_READING_HEIGHT:-0.94}"
HIDE_WS="special:omalexia"

action="${1:-toggle}"
address="${2:-}"

notify() {
  omarchy-notification-send -g "󰈈" --app-name omalexia "$@" 2>/dev/null || true
}

dispatch() {
  hyprctl dispatch "$1" >/dev/null
}

if [[ -z $address ]]; then
  address="$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')"
fi
if [[ -z $address ]]; then
  notify "No window focused"
  exit 1
fi

clients="$(hyprctl clients -j)"
window="$(jq -c --arg a "$address" '.[] | select(.address == $a)' <<<"$clients")"
if [[ -z $window ]]; then
  echo "No window with address $address" >&2
  exit 1
fi
floating="$(jq -r '.floating' <<<"$window")"
monitor_id="$(jq -r '.monitor' <<<"$window")"
workspace_id="$(jq -r '.workspace.id' <<<"$window")"
marker="$STATE_DIR/${address//\//_}"

# Monitor geometry in logical pixels: position, size/scale, reserved edges
# (bar) as [left, top, right, bottom].
read -r mon_x mon_y mon_w mon_h mon_scale res_l res_t res_r res_b < <(hyprctl monitors -j |
  jq -r --argjson id "$monitor_id" '.[] | select(.id == $id) |
    "\(.x) \(.y) \(.width) \(.height) \(.scale) \(.reserved[0]) \(.reserved[1]) \(.reserved[2]) \(.reserved[3])"')
if [[ -z ${mon_w:-} ]]; then
  notify "Could not read monitor size"
  exit 1
fi

read -r width height pos_x pos_y < <(awk \
  -v mx="$mon_x" -v my="$mon_y" -v mw="$mon_w" -v mh="$mon_h" -v s="$mon_scale" \
  -v rl="$res_l" -v rt="$res_t" -v rr="$res_r" -v rb="$res_b" \
  -v wf="$WIDTH_FRACTION" -v hf="$HEIGHT_FRACTION" -v max="$MAX_WIDTH" 'BEGIN {
    lw = mw / s - rl - rr; lh = mh / s - rt - rb
    w = lw * wf; if (w > max) w = max
    h = lh * hf
    x = mx + rl + (lw - w) / 2
    y = my + rt + (lh - h) / 2
    printf "%d %d %d %d\n", w, h, x, y
  }')

# Windows sharing the workspace that reading mode should tuck away:
# mapped, not pinned, not the reading window itself.
others_on_workspace() {
  jq -r --arg a "$address" --argjson ws "$workspace_id" \
    '.[] | select(.workspace.id == $ws and .address != $a and .mapped == true and .pinned != true) | .address' \
    <<<"$clients"
}

reading_on() {
  mkdir -p "$STATE_DIR"
  local others prior
  others="$(others_on_workspace | jq -R . | jq -sc .)"
  if [[ -f $marker ]]; then
    # Already in reading mode: keep the original saved state, only add any
    # windows that appeared since to the hidden list.
    prior="$(cat "$marker")"
    others="$(jq -c --argjson new "$others" '(.others + $new) | unique' <<<"$prior")"
    jq -c --argjson others "$others" '.others = $others' <<<"$prior" >"$marker"
  else
    jq -cn --arg floating "$floating" --argjson ws "$workspace_id" \
      --argjson x "$(jq '.at[0]' <<<"$window")" --argjson y "$(jq '.at[1]' <<<"$window")" \
      --argjson w "$(jq '.size[0]' <<<"$window")" --argjson h "$(jq '.size[1]' <<<"$window")" \
      --argjson others "$others" \
      '{floating: $floating, workspace: $ws, x: $x, y: $y, w: $w, h: $h, others: $others}' >"$marker"
  fi
  local other
  while IFS= read -r other; do
    [[ -z $other ]] && continue
    dispatch "hl.dsp.window.move({ window = 'address:$other', workspace = '$HIDE_WS', follow = false })"
  done < <(others_on_workspace)
  if [[ $floating != "true" ]]; then
    dispatch "hl.dsp.window.float({ window = 'address:$address', action = 'float' })"
  fi
  dispatch "hl.dsp.window.resize({ window = 'address:$address', x = $width, y = $height })"
  dispatch "hl.dsp.window.move({ window = 'address:$address', x = $pos_x, y = $pos_y })"
  notify "Reading mode" "One clean window at ${width} px. Super+R brings everything back."
}

reading_off() {
  local saved_ws saved_floating other
  if [[ -f $marker ]]; then
    saved_ws="$(jq -r '.workspace' "$marker")"
    saved_floating="$(jq -r '.floating' "$marker")"
    # Bring back the windows reading mode hid, only those still hidden.
    while IFS= read -r other; do
      [[ -z $other ]] && continue
      if jq -e --arg a "$other" '.[] | select(.address == $a and (.workspace.name == "special:omalexia"))' \
          >/dev/null <<<"$clients"; then
        dispatch "hl.dsp.window.move({ window = 'address:$other', workspace = '$saved_ws', follow = false })"
      fi
    done < <(jq -r '.others[]?' "$marker")
    # The reading window sticks to its workspace: pull it back if it drifted.
    if [[ $workspace_id != "$saved_ws" ]]; then
      dispatch "hl.dsp.window.move({ window = 'address:$address', workspace = '$saved_ws', follow = false })"
    fi
    if [[ $saved_floating == "true" ]]; then
      # It was floating before: restore the exact previous geometry.
      local sx sy sw sh
      sx="$(jq -r '.x' "$marker")"; sy="$(jq -r '.y' "$marker")"
      sw="$(jq -r '.w' "$marker")"; sh="$(jq -r '.h' "$marker")"
      if [[ $floating != "true" ]]; then
        dispatch "hl.dsp.window.float({ window = 'address:$address', action = 'float' })"
      fi
      dispatch "hl.dsp.window.resize({ window = 'address:$address', x = $sw, y = $sh })"
      dispatch "hl.dsp.window.move({ window = 'address:$address', x = $sx, y = $sy })"
    elif [[ $floating == "true" ]]; then
      dispatch "hl.dsp.window.float({ window = 'address:$address', action = 'tile' })"
    fi
    rm -f "$marker"
  elif [[ $floating == "true" ]]; then
    dispatch "hl.dsp.window.float({ window = 'address:$address', action = 'tile' })"
  fi
  notify "Reading mode off"
}

case "$action" in
  on) reading_on ;;
  off) reading_off ;;
  status)
    if [[ -f $marker && $floating == "true" ]]; then echo on; else echo off; fi
    ;;
  toggle)
    if [[ -f $marker && $floating == "true" ]]; then
      reading_off
    else
      reading_on
    fi
    ;;
  *)
    echo "Usage: omalexia-focus [toggle|on|off|status] [window-address]" >&2
    exit 1
    ;;
esac
