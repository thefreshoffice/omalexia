#!/usr/bin/python3
"""omalexia-locate: find and follow the words of the current utterance on
screen.

Reads the utterance the daemon just started ($XDG_RUNTIME_DIR/omalexia/
utterance: id, language, prepared text), screenshots the focused window,
and maps the spoken words to their on-screen boxes. Prints one JSON object
per line:

  {"ok": true, "id": N, "backend": "selection|ocr", "matched": n,
   "total": m, "boxes": [{"start": .., "end": .., "x": .., "y": .., "w": .., "h": ..}]}

"start"/"end" are the same global char offsets the daemon's word events
carry, so an overlay can look a box up straight from an event. Coordinates
are Hyprland layout (logical) pixels. ok:false means the text cannot be
found on screen right now; the caller then simply highlights nothing.

Without --follow one line is printed and the tool exits. With --follow it
keeps watching for the rest of the utterance, the way macOS Spoken Content
re-queries text geometry while it speaks: about once a second the window
is re-captured, the tracked text region is re-found by row-signature
correlation (so scrolling and window moves shift the boxes instead of
stranding them), a moved selection is re-fitted exactly, and text that
left the screen clears the highlight rather than mislabeling whatever
took its place. A new line is printed whenever the boxes change. The tool
exits by itself when the utterance is over (utterance id or daemon state
file changes).

Two acquisition backends, best first:

selection: when the reading came from a visible selection, the highlight
  itself marks the text. The highlighted rows are found by color (long
  solid runs of non-background, which covers both a themed selection color
  and foot-style inverted fg/bg), the primary selection's line structure is
  fitted onto them as a character grid, and every word's box follows by
  arithmetic. No OCR, exact to the pixel, tens of milliseconds.

ocr: tesseract word boxes aligned to the spoken words (banded,
  single-threaded workers, a cursor-band fast pass). Works for clipboard
  and screen reads, or when the selection is gone from view. Lone matches
  that disagree geometrically with their neighbours are dropped rather
  than highlighted in the wrong place.

Testing hooks: --image FILE --origin X,Y --scale S skip hyprctl and grim;
--selection FILE stands in for the primary selection.
"""

from __future__ import annotations

import difflib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import unicodedata
from pathlib import Path

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "omalexia"

# tesseract traineddata names for the daemon's language codes; anything not
# installed (or not listed) falls back to English, which still finds most
# Latin-script words.
TESS_LANGS = {
    "en": "eng", "nl": "nld", "de": "deu", "fr": "fra", "es": "spa",
    "it": "ita", "pt": "por", "da": "dan", "sv": "swe", "no": "nor",
    "fi": "fin", "pl": "pol", "cs": "ces", "ro": "ron", "hu": "hun",
    "tr": "tur", "ru": "rus", "uk": "ukr", "el": "ell",
}

CURSOR_BAND = 450   # logical px above/below the cursor for the OCR fast pass
TICK = 0.7          # seconds between follow checks
SIG_COLS = 48       # sampled columns per row in the tracking signature


def norm(word: str) -> str:
    """Fold a word for matching: NFKC (ligatures), lowercase, alnum only."""
    return re.sub(r"[\W_]+", "", unicodedata.normalize("NFKC", word).lower(), flags=re.UNICODE)


def run(cmd, timeout=15, **kw):
    return subprocess.run(cmd, capture_output=True, timeout=timeout, check=False, **kw)


def emit(uid, ok, backend=None, boxes=None, matched=0, total=0, error=None, timings=None):
    obj: dict = {"ok": ok, "id": uid}
    if ok:
        obj.update(backend=backend, matched=matched, total=total, boxes=boxes or [])
    else:
        obj["error"] = error
    if timings:
        obj["t"] = timings
    print(json.dumps(obj), flush=True)


# --------------------------------------------------------------------------
# Window and screenshot plumbing
# --------------------------------------------------------------------------


def _window_dict(win, monitors):
    x, y = win.get("at", [0, 0])
    w, h = win.get("size", [0, 0])
    if w <= 0 or h <= 0:
        return None
    scale = 1.0
    for mon in monitors:
        if mon.get("id") == win.get("monitor"):
            scale = float(mon.get("scale") or 1.0)
    return {"x": float(x), "y": float(y), "w": float(w), "h": float(h),
            "scale": scale, "address": win.get("address"), "pid": win.get("pid"),
            "title": win.get("title")}


def ensure_session_env() -> None:
    """The daemon that spawns us is a systemd user service; started on a
    clean boot it can come up before Hyprland exports its session variables
    and then hands that empty environment down, which breaks hyprctl (no
    focused window), grim (no screenshots) and wtype. Derive what is missing
    from the runtime directory, the same way omarchy-restart-shell does."""
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        try:
            dirs = sorted((d for d in (runtime / "hypr").iterdir() if d.is_dir()),
                          key=lambda d: d.stat().st_mtime)
        except OSError:
            dirs = []
        if dirs:
            os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = dirs[-1].name
    if not os.environ.get("WAYLAND_DISPLAY"):
        try:
            socks = sorted((s for s in runtime.glob("wayland-*")
                            if not s.name.endswith(".lock")),
                           key=lambda p: p.stat().st_mtime)
        except OSError:
            socks = []
        if socks:
            os.environ["WAYLAND_DISPLAY"] = socks[-1].name


def focused_window():
    try:
        win = json.loads(run(["hyprctl", "activewindow", "-j"], timeout=5).stdout or "{}")
        monitors = json.loads(run(["hyprctl", "monitors", "-j"], timeout=5).stdout or "[]")
    except ValueError:
        return None
    if not win.get("address"):
        return None
    return _window_dict(win, monitors)


def window_focused(address) -> bool:
    try:
        win = json.loads(run(["hyprctl", "activewindow", "-j"], timeout=5).stdout or "{}")
    except ValueError:
        return False
    return bool(address) and win.get("address") == address


def window_by_address(address):
    try:
        clients = json.loads(run(["hyprctl", "clients", "-j"], timeout=5).stdout or "[]")
        monitors = json.loads(run(["hyprctl", "monitors", "-j"], timeout=5).stdout or "[]")
    except ValueError:
        return None
    for win in clients:
        if win.get("address") == address and win.get("mapped"):
            return _window_dict(win, monitors)
    return None


def cursor_pos():
    """Layout position of the mouse cursor ("x, y" from hyprctl)."""
    try:
        parts = run(["hyprctl", "cursorpos"], timeout=5).stdout.decode().replace(",", " ").split()
        return float(parts[0]), float(parts[1])
    except (IndexError, ValueError):
        return None


def read_primary_selection(override: Path | None) -> str:
    if override is not None:
        try:
            return override.read_text()
        except OSError:
            return ""
    r = run(["wl-paste", "--primary", "--no-newline"], timeout=5)
    return r.stdout.decode("utf-8", "replace") if r.returncode == 0 else ""


def screenshot(window, band=None):
    """The window region as an RGB array, via raw PPM (no codec time).
    `band` (top, bottom in image pixels) captures just that strip: the
    cheap way to check for scrolling on every tick."""
    x, y = window["x"], window["y"]
    w, h = window["w"], window["h"]
    if band is not None:
        scale = window["scale"]
        y = window["y"] + band[0] / scale
        h = (band[1] - band[0]) / scale
    shot = Path(tempfile.mkstemp(suffix=".ppm", dir=RUNTIME if RUNTIME.exists() else None)[1])
    try:
        r = run(["grim", "-t", "ppm", "-g", f"{x:.0f},{y:.0f} {w:.0f}x{h:.0f}",
                 str(shot)], timeout=15)
        if r.returncode != 0:
            return None
        return load_pnm(shot)
    finally:
        shot.unlink(missing_ok=True)


def load_pnm(image: Path):
    """(H, W, 3) RGB or (H, W) gray uint8 array from a PPM/PGM file (other
    formats go through one magick conversion, for the test hooks)."""
    import numpy as np
    if image.suffix in (".ppm", ".pgm", ".pnm"):
        data = image.read_bytes()
    else:
        r = run(["magick", str(image), "-depth", "8", "ppm:-"], timeout=30)
        if r.returncode != 0:
            return None
        data = r.stdout
    # PNM header: magic, width, height, maxval, separated by whitespace and
    # optional '#' comments, then one whitespace byte before the raster.
    tokens = []
    pos = 0
    while len(tokens) < 4 and pos < len(data):
        if data[pos:pos + 1].isspace():
            pos += 1
        elif data[pos:pos + 1] == b"#":
            pos = data.index(b"\n", pos) + 1
        else:
            end = pos
            while end < len(data) and not data[end:end + 1].isspace():
                end += 1
            tokens.append(data[pos:end])
            pos = end
    if len(tokens) < 4 or tokens[0] not in (b"P5", b"P6"):
        return None
    width, height = int(tokens[1]), int(tokens[2])
    maxval = int(tokens[3])
    pos += 1
    channels = 3 if tokens[0] == b"P6" else 1
    count = width * height * channels
    if maxval > 255:  # 16-bit samples, big-endian per the PNM spec
        raster = (np.frombuffer(data, dtype=">u2", count=count, offset=pos) >> 8).astype(np.uint8)
    else:
        raster = np.frombuffer(data, dtype=np.uint8, count=count, offset=pos)
    if channels == 3:
        return raster.reshape(height, width, 3)
    return raster.reshape(height, width)


def to_gray(arr):
    import numpy as np
    if arr.ndim == 2:
        return arr
    return (arr.sum(axis=2, dtype=np.uint16) // 3).astype(np.uint8)


def to_layout(img_boxes, window):
    """Image-pixel boxes to layout coordinates, dropping boxes whose center
    left the window (scrolled out: their text is clipped away)."""
    out = []
    scale = window["scale"]
    height = window["h"] * scale
    width = window["w"] * scale
    for b in img_boxes:
        cx, cy = b["x"] + b["w"] / 2, b["y"] + b["h"] / 2
        if not (0 <= cx <= width and 0 <= cy <= height):
            continue
        out.append({
            "start": b["start"], "end": b["end"],
            "x": round(window["x"] + b["x"] / scale, 1),
            "y": round(window["y"] + b["y"] / scale, 1),
            "w": round(b["w"] / scale, 1),
            "h": round(b["h"] / scale, 1),
        })
    return out


# --------------------------------------------------------------------------
# Backend 0: the terminal's own text (foot pipe-visible)
# --------------------------------------------------------------------------

# foot can pipe the visible text to a command on a key press; the installer
# binds an untypeable chord to omalexia-foot-visible, and wtype presses it.
# That yields the terminal's exact text with line structure in ~50 ms, and
# with the tty's rows x cols the position of every character is plain cell
# arithmetic: no OCR, no pixel heuristics, fresh on every check even while
# the terminal is streaming.

FOOT_KEY = ["wtype", "-M", "ctrl", "-M", "shift", "-k", "F34", "-m", "shift", "-m", "ctrl"]


def foot_pad():
    try:
        text = (Path.home() / ".config" / "foot" / "foot.ini").read_text()
        m = re.search(r"^\s*pad\s*=\s*(\d+)x(\d+)", text, re.M)
        if m:
            return float(m.group(1)), float(m.group(2))
    except OSError:
        pass
    return 0.0, 0.0


def _proc_comm(pid) -> str:
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def _tty_size(pid):
    """rows, cols of the terminal window's pty, or None."""
    out = run(["ps", "-o", "tty=", "--ppid", str(pid)], timeout=5).stdout.decode()
    tty = next((c for c in out.split() if c.startswith("pts/")), None)
    if tty is None:
        return None
    try:
        rows, cols = (int(v) for v in
                      run(["stty", "size", "-F", f"/dev/{tty}"], timeout=5).stdout.split())
    except ValueError:
        return None
    if rows < 2 or cols < 10:
        return None
    return rows, cols


def _grid_dict(window, lines, rows, cols, pad_x, pad_y):
    scale = window["scale"]
    pad_x *= scale
    pad_y *= scale
    cell_w = (window["w"] * scale - 2 * pad_x) / cols
    cell_h = (window["h"] * scale - 2 * pad_y) / rows
    if cell_w <= 2 or cell_h <= 4:
        return None
    return {"lines": lines, "rows": rows, "cols": cols, "pad_x": pad_x,
            "pad_y": pad_y, "cell_w": cell_w, "cell_h": cell_h}


def _foot_pipe(window):
    """The visible text and grid geometry of a foot window (image pixels),
    or None when this is not a foot window or the binding is missing."""
    pid = window.get("pid")
    if not pid or _proc_comm(pid) not in ("foot", "footclient"):
        return None
    size = _tty_size(pid)
    if size is None:
        return None

    visible = RUNTIME / "visible-text"
    try:
        before = visible.stat().st_mtime_ns
    except OSError:
        before = -1
    if run(FOOT_KEY, timeout=5).returncode != 0:
        return None
    for _ in range(30):
        time.sleep(0.015)
        try:
            if visible.stat().st_mtime_ns != before:
                break
        except OSError:
            continue
    else:
        return None

    pad_x, pad_y = foot_pad()
    return _grid_dict(window, visible.read_text().split("\n"), *size, pad_x, pad_y)


# Ghostty ships a stock binding that writes the screen text to a temporary
# file and puts the path on the clipboard; pressing it and restoring the
# clipboard afterwards gives the same exact grid foot's pipe does. Ghostty
# also pipes logical (unwrapped) lines with interior blanks kept.
GHOSTTY_KEY = ["wtype", "-M", "logo", "-M", "ctrl", "-M", "shift", "-k", "j",
               "-m", "shift", "-m", "ctrl", "-m", "logo"]


def _ghostty_pad():
    try:
        cfg = (Path.home() / ".config" / "ghostty" / "config").read_text()
    except OSError:
        return 2.0, 2.0
    mx = re.search(r"^\s*window-padding-x\s*=\s*(\d+)", cfg, re.M)
    my = re.search(r"^\s*window-padding-y\s*=\s*(\d+)", cfg, re.M)
    return (float(mx.group(1)) if mx else 2.0,
            float(my.group(1)) if my else 2.0)


def _ghostty_pipe(window):
    pid = window.get("pid")
    if not pid or _proc_comm(pid) != "ghostty":
        return None
    size = _tty_size(pid)
    if size is None:
        return None
    types = run(["wl-paste", "-l"], timeout=5).stdout.decode("utf-8", "replace")
    textual = "text" in types
    saved = run(["wl-paste", "-n"], timeout=5).stdout if textual else None
    if run(GHOSTTY_KEY, timeout=5).returncode != 0:
        return None
    dump = None
    for _ in range(40):
        time.sleep(0.02)
        clip = run(["wl-paste", "-n"], timeout=5).stdout.decode("utf-8", "replace").strip()
        if clip and clip != (saved or b"").decode("utf-8", "replace").strip() \
                and clip.startswith(("/tmp/", "/run/", "/var/")) and Path(clip).is_file():
            dump = Path(clip)
            break
    # Put the clipboard back the way it was; the dump path is ours, not
    # the user's copy.
    if saved is not None:
        subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                         ).communicate(saved)
    elif dump is not None:
        run(["wl-copy", "--clear"], timeout=5)
    if dump is None:
        return None
    try:
        lines = dump.read_text().split("\n")
    except OSError:
        return None
    dump.unlink(missing_ok=True)
    pad_x, pad_y = _ghostty_pad()
    return _grid_dict(window, lines, *size, pad_x, pad_y)


def _term_grid(window):
    """Whichever terminal grid the focused window offers."""
    return _foot_pipe(window) or _ghostty_pipe(window)


def foot_grid_words(window):
    """(norm, x, y, w, h, original) image-pixel words of a terminal
    window's visible text (foot or ghostty), or None."""
    grid = _term_grid(window)
    if grid is None:
        return None
    cols, cell_w, cell_h = grid["cols"], grid["cell_w"], grid["cell_h"]
    words = []
    row = 0
    for line in grid["lines"]:
        # foot pipes logical lines; longer ones wrap at the column count.
        for m in re.finditer(r"\S+", line):
            folded = norm(m.group())
            if not folded:
                continue
            row_offset, col = divmod(m.start(), cols)
            width_chars = min(m.end() - m.start(), cols - col)
            words.append((folded, grid["pad_x"] + col * cell_w,
                          grid["pad_y"] + (row + row_offset) * cell_h,
                          width_chars * cell_w, cell_h, m.group()))
        row += max(1, -(-len(line) // cols))
    return words or None


def _nearest_word(words, px, py):
    """Index of the word whose box is closest to the pointer, or None."""
    best = None
    for i, word in enumerate(words):
        x, y, w, h = word[1], word[2], word[3], word[4]
        dy = 0.0 if y <= py <= y + h else min(abs(py - y), abs(py - y - h))
        dx = 0.0 if x <= px <= x + w else min(abs(px - x), abs(px - x - w))
        distance = dy * 3 + dx
        if best is None or distance < best[0]:
            best = (distance, i)
    return best[1] if best is not None and best[0] < 220 else None


def grab_text(window, cursor, image=None):
    """The window's own text from the word under the pointer onward: the
    'read from here' source. Returns (text, source, hint). Reuses the
    exact backends so the highlighter will find every word; OCR is the
    last resort so the key works in every window."""
    px = (cursor[0] - window["x"]) * window["scale"]
    py = (cursor[1] - window["y"]) * window["scale"]
    hint = None
    grid = _term_grid(window)
    pid = window.get("pid")
    if grid is None and pid and _proc_comm(pid) in ("foot", "footclient"):
        # A foot without the pipe binding: started before the last
        # install. Exact reading returns with a fresh terminal.
        hint = "This terminal predates the last Omalexia update; open a new one for exact reading."
    if grid is not None:
        col = int(max(0, min(grid["cols"] - 1, (px - grid["pad_x"]) // grid["cell_w"])))
        vrow = int((py - grid["pad_y"]) // grid["cell_h"])
        row = 0
        for i, line in enumerate(grid["lines"]):
            span = max(1, -(-len(line) // grid["cols"]))
            if vrow < row + span:
                idx = min((vrow - row) * grid["cols"] + col, len(line))
                while idx > 0 and not line[idx - 1].isspace():
                    idx -= 1
                parts = [line[idx:]] + grid["lines"][i + 1:]
                text = "\n".join(parts).strip()
                if text:
                    return text, "grid", None
                break
            row += span
    if pid:
        # The tree can still be building (Chromium fills it in
        # asynchronously once an assistive client shows up); a
        # user-initiated grab can afford a few patient attempts.
        words = None
        for attempt in range(3):
            words = tree_words(window)
            if words:
                break
            time.sleep(0.8)
        if words:
            words = [w for w in words if len(w) >= 6]
            start = _nearest_word(words, px, py)
            if start is not None:
                text = " ".join(w[5] for w in words[start:]).strip()
                if text:
                    return text, "tree", hint
    # Last resort: read the pixels. OCR words can be imperfect, but the
    # key then works in every window, exact sources or not.
    arr = load_pnm(image) if image is not None else screenshot(window)
    if arr is not None and arr.size:
        gray = to_gray(arr)
        if gray.mean() < 128:
            gray = 255 - gray
        installed = run(["tesseract", "--list-langs"], timeout=10).stdout.decode("utf-8", "replace").split()
        combo = "+".join(l for l in ("eng", "nld") if l in installed) or "eng"
        words = [w for w in ocr_array(gray, 0, combo) if len(w) >= 6]
        start = _nearest_word(words, px, py)
        if start is not None:
            text = " ".join(w[5] for w in words[start:]).strip()
            if text:
                return text, "ocr", hint
    return None, "no readable text under the pointer", hint


# --------------------------------------------------------------------------
# Backend 0.5: the app's accessibility tree (AT-SPI)
# --------------------------------------------------------------------------

# The macOS way, on Linux: ask the application itself. Browsers, Electron
# apps, GTK and Qt editors expose their text and geometry over AT-SPI once
# an assistive client is around (the daemon raises the session flags, and
# querying relation sets is the Orca-like tell that makes Chromium build
# its web tree retroactively). Range extents are degenerate under
# Chromium/Wayland, but node boxes and layout line boundaries work, which
# pins every word to its exact line with a character-width estimate for x.

_ATSPI_CACHE: dict = {"mod": None}


def _atspi():
    if _ATSPI_CACHE["mod"] is None:
        try:
            import gi
            gi.require_version("Atspi", "2.0")
            from gi.repository import Atspi
            _ATSPI_CACHE["mod"] = Atspi
        except Exception:  # noqa: BLE001
            _ATSPI_CACHE["mod"] = False
    return _ATSPI_CACHE["mod"] or None


def _atspi_app(Atspi, pid):
    desktop = Atspi.get_desktop(0)
    for i in range(desktop.get_child_count()):
        app = desktop.get_child_at_index(i)
        try:
            if app is not None and app.get_process_id() == pid:
                return app
        except Exception:  # noqa: BLE001
            continue
    return None


def _atspi_poke(node, depth=0):
    """Chromium and Electron build their web trees only once an assistive
    client behaves like one; querying relation sets is the signal."""
    if node is None or depth > 2:
        return
    try:
        node.get_relation_set()
        count = node.get_child_count()
    except Exception:  # noqa: BLE001
        return
    for j in range(min(count, 20)):
        _atspi_poke(node.get_child_at_index(j), depth + 1)


def _atspi_frame(Atspi, app, window):
    """The frame of `window` among the app's toplevels: the ACTIVE one,
    else a title match, else the one whose size matches the window (an app
    can hold many windows and only the right one has a built tree)."""
    title = window.get("title")
    frames = []
    try:
        count = app.get_child_count()
    except Exception:  # noqa: BLE001
        return None
    for i in range(count):
        frame = app.get_child_at_index(i)
        if frame is None:
            continue
        frames.append(frame)
        try:
            if frame.get_state_set().contains(Atspi.StateType.ACTIVE):
                return frame
        except Exception:  # noqa: BLE001
            continue
    for frame in frames:
        try:
            if title and frame.get_name() == title:
                return frame
        except Exception:  # noqa: BLE001
            continue
    for frame in frames:
        try:
            e = Atspi.Component.get_extents(frame, Atspi.CoordType.WINDOW)
            for units in (1.0, window["scale"]):
                if (abs(e.width - window["w"] * units) <= 4
                        and abs(e.height - window["h"] * units) <= 4):
                    return frame
        except Exception:  # noqa: BLE001
            continue
    return frames[0] if frames else None


def _node_words(Atspi, node, extents):
    """Words of one text node with raw-toolkit-unit boxes: exact range
    extents when the toolkit provides them, else the node box divided by
    its layout lines with a character-width estimate."""
    n = Atspi.Text.get_character_count(node)
    if not 1 <= n <= 20000:
        return []
    text = Atspi.Text.get_text(node, 0, n)
    if not text.strip():
        return []
    lines = []
    try:
        off = 0
        for _ in range(400):
            if off >= n:
                break
            got = Atspi.Text.get_string_at_offset(node, off, Atspi.TextGranularity.LINE)
            if got is None or got.end_offset <= off:
                break
            lines.append((got.start_offset, got.end_offset))
            off = got.end_offset
    except Exception:  # noqa: BLE001
        # A flaky line query must not discard the node: its box is still
        # the best geometry there is; treat the text as one line.
        lines = []
    if not lines:
        lines = [(0, n)]
    x, y, w, h = extents
    line_h = h / len(lines)
    longest = max(max(le - ls, 1) for ls, le in lines)
    # A block node is wider than its text ink; a glyph is never much wider
    # than the line is tall, so cap the estimate.
    char_w = min(w / longest, line_h * 0.62)
    words = []
    for i, (ls, le) in enumerate(lines):
        segment = text[ls:le]
        for m in re.finditer(r"\S+", segment):
            folded = norm(m.group())
            if not folded:
                continue
            box = None
            try:
                r = Atspi.Text.get_range_extents(
                    node, ls + m.start(), ls + m.end(), Atspi.CoordType.WINDOW)
                if r.width > 1 and r.height > 1:
                    box = (float(r.x), float(r.y), float(r.width), float(r.height))
            except Exception:  # noqa: BLE001
                pass
            if box is None:
                box = (x + m.start() * char_w, y + i * line_h,
                       max(char_w, (m.end() - m.start()) * char_w), line_h)
            words.append((folded, *box, m.group()))
    return words


def tree_words(window):
    """(norm, x, y, w, h) image-pixel words from the focused application's
    accessibility tree, or None when the app does not serve one."""
    Atspi = _atspi()
    pid = window.get("pid")
    if Atspi is None or not pid:
        return None

    # Units are mixed PER NODE inside one application: web content (inside
    # a document subtree) reports physical device pixels, while the same
    # app's own chrome, and whole GTK and Qt apps, report logical ones.
    # Resolve by ancestry while walking.
    logical_units = window["scale"] if window["scale"] > 1.01 else 1.0

    def collect(root, deadline):
        visited = [0]

        def walk(node, depth, in_document):
            if node is None or depth > 40 or visited[0] > 4000 or time.time() > deadline:
                return []
            visited[0] += 1
            got = []
            try:
                count = node.get_child_count()
            except Exception:  # noqa: BLE001
                return []
            if count > 0 and not in_document:
                try:
                    in_document = node.get_role_name().startswith("document")
                except Exception:  # noqa: BLE001
                    pass
            for j in range(min(count, 150)):
                got += walk(node.get_child_at_index(j), depth + 1, in_document)
            if got:
                return got
            if not isinstance(node, Atspi.Text):
                return []
            try:
                # No SHOWING check: Chromium populates states asynchronously
                # after building the tree, and an early walk would reject
                # perfectly visible text. The box is ready immediately and
                # zero-sized boxes already filter what is not rendered.
                e = Atspi.Component.get_extents(node, Atspi.CoordType.WINDOW)
            except Exception:  # noqa: BLE001
                return []
            if e.width <= 2 or e.height <= 2:
                return []
            units = 1.0 if in_document else logical_units
            try:
                return _node_words(Atspi, node, (e.x * units, e.y * units,
                                                 e.width * units, e.height * units))
            except Exception:  # noqa: BLE001
                return []
        return walk(root, 0, False)

    try:
        app = _atspi_app(Atspi, pid)
        if app is None:
            return None
        root = _atspi_frame(Atspi, app, window)
        if root is None:
            return None
        raw = collect(root, time.time() + 2.0)
        if not raw:
            _atspi_poke(app)
            time.sleep(0.9)
            root = _atspi_frame(Atspi, app, window)
            raw = collect(root, time.time() + 2.5) if root is not None else []
        if not raw:
            return None
        return raw
    except Exception:  # noqa: BLE001
        return None


# --------------------------------------------------------------------------
# Backend 1: the selection highlight as a character grid
# --------------------------------------------------------------------------


def selection_line_runs(sel_text: str) -> list[list[str]]:
    """The selection's non-empty lines, grouped into runs separated by blank
    lines (a blank line leaves a gap in the on-screen highlight)."""
    runs: list[list[str]] = []
    cur: list[str] = []
    for ln in sel_text.split("\n"):
        if ln.strip():
            cur.append(ln.rstrip())
        elif cur:
            runs.append(cur)
            cur = []
    if cur:
        runs.append(cur)
    return runs


def line_layout(segments, total_lines):
    """Assign an integer number of text lines to each highlight segment so
    the counts sum to the selection's line count, by finding one line
    height that explains every segment. A terminal selection is one tall
    segment; a browser one may leave a small gap between line boxes."""
    best = None
    for seg in segments:
        span = seg[-1] - seg[0] + 1
        for k in range(1, min(total_lines, max(1, span // 7)) + 1):
            height = span / k
            if not 7 <= height <= 90:
                continue
            counts = []
            residual = 0.0
            ok = True
            for other in segments:
                other_span = other[-1] - other[0] + 1
                count = max(1, round(other_span / height))
                if abs(other_span - count * height) > 0.4 * height:
                    ok = False
                    break
                counts.append(count)
                residual += abs(other_span - count * height)
            if not ok or sum(counts) != total_lines:
                continue
            if best is None or residual < best[0]:
                best = (residual, counts)
    if best is None:
        return None
    spans = []
    for seg, count in zip(segments, best[1]):
        top, bottom = int(seg[0]), int(seg[-1])
        span = bottom - top + 1
        for j in range(count):
            r0 = top + int(round(j * span / count))
            r1 = top + int(round((j + 1) * span / count)) - 1
            spans.append((r0, max(r0, r1)))
    return spans


def fit_lines(mask, codes, line_spans, texts, np):
    """Fit the selection's lines onto the detected text-line row spans.
    Returns per-line geometry and the grid's cell width, or None."""
    lines = []  # (text, left, top, rows, width)
    for (r0, r1), text in zip(line_spans, texts):
        rows = mask[r0:r1 + 1]
        density = rows.mean(axis=0)
        kernel = np.ones(9) / 9
        smooth = np.convolve(density, kernel, "same")
        selected = smooth >= 0.55
        cols = np.flatnonzero(selected)
        if cols.size == 0:
            return None
        # largest contiguous run of selected columns
        splits = np.flatnonzero(np.diff(cols) > 1)
        pieces = np.split(cols, splits + 1)
        piece = max(pieces, key=len)
        left, right = int(piece[0]), int(piece[-1])
        width = right - left + 1
        # It must look like text on a highlight: glyph pixels breaking
        # the fill colour (whatever both colours are), but nowhere near
        # an unreadable jumble. A solid bar or image fails here.
        interior = codes[r0:r1 + 1, left:right + 1]
        fill = np.bincount(interior.ravel(), minlength=4096).max()
        glyph_frac = 1.0 - fill / interior.size
        if not 0.02 <= glyph_frac <= 0.6:
            return None
        lines.append((text, left, r0, r1 - r0 + 1, width))
    ratios = [w / max(1, len(t)) for t, _, _, _, w in lines]
    if min(ratios) < 3 or max(ratios) > 80:
        return None
    # Uniform character width means a terminal grid and exact word maths;
    # varying width means a proportional font (a browser selection), still
    # line-exact with words placed by their character share of the line.
    monospace = max(ratios) <= min(ratios) * 1.15
    cell_w = None
    if monospace:
        cell_w = min(ratios)
        if not 4 <= cell_w <= 64:
            return None
        # Trailing highlighted whitespace may widen a row, but never by much.
        if any(w > len(t) * cell_w * 1.25 + 4 * cell_w for t, _, _, _, w in lines):
            return None
    chars = [len(t) for t, *_ in lines]
    widths = [w for *_, w in lines]
    if len(lines) >= 3 and len(set(chars)) >= 3 and len(set(widths)) >= 2:
        if float(np.corrcoef(chars, widths)[0, 1]) < 0.85:
            return None
    return {"lines": lines, "cell_w": cell_w, "score": -float(np.std(ratios))}


def selection_boxes(rgb, sel_text, spoken):
    """Image-pixel boxes for the spoken words from the on-screen selection
    highlight, or None when no credible highlight matches its shape."""
    import numpy as np
    if rgb is None or rgb.ndim != 3:
        return None
    line_runs = selection_line_runs(sel_text)
    total_lines = sum(len(r) for r in line_runs)
    if not line_runs or total_lines > 300:
        return None
    height, width = rgb.shape[:2]
    codes = ((rgb[:, :, 0] >> 4).astype(np.uint16) << 8) \
        | ((rgb[:, :, 1] >> 4).astype(np.uint16) << 4) \
        | (rgb[:, :, 2] >> 4).astype(np.uint16)
    hist = np.bincount(codes.ravel(), minlength=4096)
    background = int(hist.argmax())
    mask = codes != background
    # Rows that carry a long solid run of non-background: a selection body
    # (themed colour or inverted fg/bg alike). Plain text rows never do,
    # since the gaps between glyphs are background.
    idx = np.arange(width)
    last_bg = np.maximum.accumulate(np.where(~mask, idx, -1), axis=1)
    rowmax = np.where(mask, idx - last_bg, 0).max(axis=1)
    rows = np.flatnonzero(rowmax >= 24)
    if rows.size == 0:
        return None
    splits = np.flatnonzero(np.diff(rows) > 3)
    segments = [seg for seg in np.split(rows, splits + 1) if seg[-1] - seg[0] + 1 >= 5]
    flat = [text for run in line_runs for text in run]
    if not segments or not flat:
        return None
    best = None
    # The right highlight may sit among unrelated solid regions; try every
    # window of consecutive segments that can hold the selection's lines.
    for a in range(len(segments)):
        for b in range(a, min(len(segments), a + len(flat))):
            layout = line_layout(segments[a:b + 1], len(flat))
            if layout is None:
                continue
            fit = fit_lines(mask, codes, layout, flat, np)
            if fit and (best is None or fit["score"] > best["score"]):
                best = fit
    if best is None:
        return None

    cell_w = best["cell_w"]
    sel_words = []  # (norm, x, y, w, h) in image pixels
    for text, left, top, rows_h, line_w in best["lines"]:
        length = max(1, len(text))
        for m in re.finditer(r"\S+", text):
            folded = norm(m.group())
            if not folded:
                continue
            if cell_w is not None:
                x = left + m.start() * cell_w
                w = (m.end() - m.start()) * cell_w
            else:
                x = left + line_w * (m.start() / length)
                w = line_w * ((m.end() - m.start()) / length)
            sel_words.append((folded, x, top, w, rows_h))
    if not sel_words:
        return None
    matcher = difflib.SequenceMatcher(
        a=[t[2] for t in spoken], b=[t[0] for t in sel_words], autojunk=False)
    boxes = []
    for a, b, size in matcher.get_matching_blocks():
        for k in range(size):
            start, end, _ = spoken[a + k]
            _, x, y, w, h = sel_words[b + k]
            boxes.append({"start": start, "end": end,
                          "x": round(x, 1), "y": round(y, 1),
                          "w": round(w, 1), "h": round(h, 1)})
    # The utterance is the prepared version of this very selection, so a
    # weak match means we fitted the wrong thing; let OCR decide instead.
    if len(boxes) < 0.75 * min(len(spoken), len(sel_words)):
        return None
    return boxes


# --------------------------------------------------------------------------
# Backend 2: OCR
# --------------------------------------------------------------------------


def tess_language(lang: str) -> str:
    tess_lang = TESS_LANGS.get(lang, "eng")
    langs = run(["tesseract", "--list-langs"], timeout=10).stdout.decode("utf-8", "replace")
    return tess_lang if tess_lang in langs.split() else "eng"


def ocr_array(gray, base_y: int, tess_lang: str) -> list[tuple[str, float, float, float, float]]:
    """(normalized word, x, y, w, h) per OCR word in image pixels, y offset
    by base_y. A dense screen (a full terminal of text) is slow to OCR in
    one piece: tesseract's runtime grows with the number of text lines, and
    its OpenMP threading loses about 3x to overhead. Single-threaded
    workers on overlapping horizontal bands, run concurrently, get a 13 s
    Claude TUI screen down to about 2 s. Bands are written as raw PGM so no
    time goes into image codecs."""
    height, width = gray.shape
    bands = max(1, min(8, height // 300))
    overlap = 60
    band_h = height // bands
    env = dict(os.environ, OMP_THREAD_LIMIT="1")
    jobs = []
    crops = []
    for i in range(bands):
        top = max(0, i * band_h - (overlap if i else 0))
        bottom = min(height, (i + 1) * band_h + (overlap if i < bands - 1 else 0))
        src = Path(tempfile.mkstemp(suffix=f".band{i}.pgm",
                                    dir=RUNTIME if RUNTIME.exists() else None)[1])
        crops.append(src)
        chunk = gray[top:bottom]
        src.write_bytes(b"P5\n%d %d\n255\n" % (width, bottom - top) + chunk.tobytes())
        jobs.append((top, subprocess.Popen(
            ["tesseract", str(src), "-", "-l", tess_lang, "tsv"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env,
            # OCR is latency-tolerant; speech synthesis is not. Yield a
            # little so the voice never pauses for a screenshot, but not so
            # much that a busy system starves the boxes for seconds (the
            # pre-buffer already shields the audio).
            preexec_fn=lambda: os.nice(4))))

    words = []
    seen: dict[str, list[tuple[float, float]]] = {}
    for top, proc in jobs:
        try:
            out = proc.communicate(timeout=60)[0].decode("utf-8", "replace")
        except subprocess.TimeoutExpired:
            proc.kill()
            continue
        for line in out.splitlines()[1:]:
            cols = line.split("\t")
            if len(cols) < 12 or cols[0] != "5":
                continue
            try:
                left, band_top, w, h = (float(c) for c in cols[6:10])
                conf = float(cols[10])
            except ValueError:
                continue
            text = norm(cols[11])
            if conf < 30 or not text:
                continue
            y = band_top + top
            # The overlap zone yields the same word twice; keep the first.
            if any(abs(px - left) < 8 and abs(py - y) < 8 for px, py in seen.get(text, ())):
                continue
            seen.setdefault(text, []).append((left, y))
            words.append((text, left, y + base_y, w, h, cols[11]))
    for crop in crops:
        crop.unlink(missing_ok=True)
    return words


def align(spoken, ocr) -> list[dict]:
    """Match the spoken word sequence to the OCR word sequence and return
    image-pixel boxes keyed by the spoken char offsets, tagged with the
    size of the matching block they came from."""
    matcher = difflib.SequenceMatcher(
        a=[t[2] for t in spoken], b=[t[0] for t in ocr], autojunk=False)
    boxes = []
    for a, b, size in matcher.get_matching_blocks():
        for k in range(size):
            start, end, _ = spoken[a + k]
            word = ocr[b + k]  # (norm, x, y, w, h[, original text])
            boxes.append({"start": start, "end": end, "_block": size, "_i": a + k,
                          "x": round(word[1], 1), "y": round(word[2], 1),
                          "w": round(word[3], 1), "h": round(word[4], 1)})
    return boxes


def drop_outliers(boxes) -> list[dict]:
    """A word matched on its own (block of one) can be a different instance
    of the same word elsewhere on screen: exactly the highlight-in-the-
    wrong-place bug. Keep lone matches only where their neighbours put the
    reading; runs of two or more words are their own evidence."""
    anchors = [b for b in boxes if b["_block"] >= 2]
    if not anchors:
        return boxes
    heights = sorted(b["h"] for b in anchors)
    line_h = max(4.0, heights[len(heights) // 2])
    kept = []
    for box in boxes:
        if box["_block"] >= 2:
            kept.append(box)
            continue
        prev = next((a for a in reversed(anchors) if a["_i"] < box["_i"]), None)
        nxt = next((a for a in anchors if a["_i"] > box["_i"]), None)
        ys = [a["y"] for a in (prev, nxt) if a is not None]
        low, high = min(ys), max(ys)
        if not low - 1.6 * line_h <= box["y"] <= high + 1.6 * line_h:
            continue
        # Same line as a neighbour means the x order must hold too.
        if prev and abs(box["y"] - prev["y"]) < 0.6 * line_h and box["x"] <= prev["x"]:
            continue
        if nxt and abs(box["y"] - nxt["y"]) < 0.6 * line_h and box["x"] >= nxt["x"]:
            continue
        kept.append(box)
    return kept


def strip_tags(boxes) -> list[dict]:
    for box in boxes:
        box.pop("_block", None)
        box.pop("_i", None)
    return boxes


def level_lines(boxes) -> list[dict]:
    """OCR boxes follow the ink, so 'glide' is tall and 'across' is short
    and the marker bounces inside one line. Give every text line a single
    top and height so the pill rides a rail."""
    if not boxes:
        return boxes
    heights = sorted(b["h"] for b in boxes)
    line_h = max(6.0, heights[len(heights) // 2])
    order = sorted(range(len(boxes)), key=lambda i: boxes[i]["y"])
    i = 0
    while i < len(order):
        base = boxes[order[i]]["y"]
        group = [order[i]]
        j = i + 1
        while j < len(order) and boxes[order[j]]["y"] - base < 0.6 * line_h:
            group.append(order[j])
            j += 1
        tops = sorted(boxes[g]["y"] for g in group)
        bottoms = sorted(boxes[g]["y"] + boxes[g]["h"] for g in group)
        top = tops[len(tops) // 2]
        bottom = bottoms[len(bottoms) // 2]
        for g in group:
            boxes[g]["y"] = round(top, 1)
            boxes[g]["h"] = round(max(bottom - top, line_h * 0.8), 1)
        i = j
    return boxes


def fill_gaps(boxes, spoken) -> list[dict]:
    """Words the matcher missed still deserve a marker: between two anchored
    neighbours on one line, the gap is where the missing words sit. Without
    this every miss blinks the highlight off and on again."""
    if not boxes:
        return boxes
    index_of = {t[0]: i for i, t in enumerate(spoken)}
    by_start = {b["start"]: b for b in boxes}
    matched = sorted(index_of[s] for s in by_start if s in index_of)
    out = list(boxes)
    for a, b in zip(matched, matched[1:]):
        gap = b - a - 1
        if not 1 <= gap <= 3:
            continue
        left = by_start[spoken[a][0]]
        right = by_start[spoken[b][0]]
        if abs(left["y"] - right["y"]) > 0.6 * max(left["h"], right["h"]):
            # Across a line break the wrap point is unknowable; place one
            # missing word next to an anchor rather than skip its beat, but
            # never guess a whole run of them.
            if gap != 1:
                continue
            s, e, _ = spoken[a + 1]
            char_w = (left["w"] / max(1, left["end"] - left["start"])
                      + right["w"] / max(1, right["end"] - right["start"])) / 2
            width = max(4.0, char_w * (e - s))
            x = right["x"] - width - char_w
            if x >= 2:
                out.append({"start": s, "end": e, "x": round(x, 1),
                            "y": right["y"], "w": round(width, 1), "h": right["h"]})
            else:
                out.append({"start": s, "end": e,
                            "x": round(left["x"] + left["w"] + char_w, 1),
                            "y": left["y"], "w": round(width, 1), "h": left["h"]})
            continue
        span0 = left["x"] + left["w"]
        span1 = right["x"]
        if span1 - span0 < 5 * gap:
            continue
        step = (span1 - span0) / gap
        for k in range(gap):
            s, e, _ = spoken[a + 1 + k]
            out.append({"start": s, "end": e,
                        "x": round(span0 + k * step + 1, 1), "y": left["y"],
                        "w": round(max(step - 2, 3), 1), "h": left["h"]})
    return out


# --------------------------------------------------------------------------
# Acquisition and tracking
# --------------------------------------------------------------------------


def acquire(arr, window, spoken, sel_text, tess_lang, cursor_img_y, allow_ocr,
            timings, try_grid=True):
    """One attempt to place the spoken words on this screenshot. Returns
    (image boxes, backend) or (None, reason); backend "ocr-partial" means
    only the fast cursor band ran and a full pass should upgrade it."""
    if try_grid and window is not None:
        t0 = time.time()
        grid = foot_grid_words(window)
        timings["grid"] = round(time.time() - t0, 2)
        if grid:
            boxes = strip_tags(drop_outliers(align(spoken, grid)))
            if len(boxes) >= 8 or len(boxes) / max(1, len(spoken)) >= 0.5:
                return fill_gaps(boxes, spoken), "grid"
        t0 = time.time()
        tree = tree_words(window)
        timings["tree"] = round(time.time() - t0, 2)
        if tree:
            boxes = strip_tags(drop_outliers(align(spoken, tree)))
            # Chromium fills its tree in asynchronously; a weak match is
            # often just an early snapshot, so look once more.
            if len(boxes) < 0.7 * len(spoken):
                time.sleep(0.6)
                again = tree_words(window)
                if again:
                    retry = strip_tags(drop_outliers(align(spoken, again)))
                    if len(retry) > len(boxes):
                        boxes = retry
            if len(boxes) >= 8 or len(boxes) / max(1, len(spoken)) >= 0.5:
                return fill_gaps(boxes, spoken), "tree"
    if sel_text.strip():
        t0 = time.time()
        found = selection_boxes(arr if arr.ndim == 3 else None, sel_text, spoken)
        timings["sel"] = round(time.time() - t0, 2)
        if found:
            return fill_gaps(found, spoken), "selection"
    if not allow_ocr:
        return None, "selection not on screen"
    gray = to_gray(arr)
    # Dark themes have light text on dark ground; tesseract reads those far
    # better negated.
    if gray.mean() < 128:
        gray = 255 - gray
    boxes = []
    partial = False
    if cursor_img_y is not None:
        y0 = int(max(0, cursor_img_y - CURSOR_BAND))
        y1 = int(min(gray.shape[0], cursor_img_y + CURSOR_BAND))
        if y1 - y0 >= 200 and y1 - y0 < gray.shape[0]:
            t0 = time.time()
            ocr = ocr_array(gray[y0:y1], y0, tess_lang)
            boxes = drop_outliers(align(spoken, ocr))
            timings["band"] = round(time.time() - t0, 2)
            # A partial band result still goes out right away (the first
            # marker should not wait for a full-window pass on a dense
            # screen); the follower upgrades it a tick later.
            if len(boxes) < 0.85 * len(spoken):
                partial = len(boxes) >= max(6, 0.4 * len(spoken))
                if not partial:
                    boxes = []
    if not boxes:
        t0 = time.time()
        ocr = ocr_array(gray, 0, tess_lang)
        timings["ocr"] = round(time.time() - t0, 2)
        boxes = drop_outliers(align(spoken, ocr))
    boxes = fill_gaps(level_lines(strip_tags(boxes)), spoken)
    # A partial match is fine (a long article is only partly on screen); a
    # tiny one means the focused window shows different text.
    if len(boxes) < 8 and len(boxes) / max(1, len(spoken)) < 0.5:
        return None, f"text not on screen ({len(boxes)}/{len(spoken)} words matched)"
    return boxes, ("ocr-partial" if partial else "ocr")


def signature(gray, np):
    """A compact per-row fingerprint of the screen for scroll tracking."""
    width = gray.shape[1]
    cols = np.linspace(0, width - 1, SIG_COLS).astype(int)
    return gray[:, cols].astype(np.int16)


def find_shift(ref, sig, expected, np, radius=700):
    """Where the reference strip sits in the new signature: its top row, or
    None when there is no confident match."""
    if float(np.std(ref)) < 5:
        return None  # a near-blank strip matches anywhere
    height, strip = sig.shape[0], ref.shape[0]
    lo = max(0, int(expected) - radius)
    hi = min(height - strip, int(expected) + radius)
    if hi < lo:
        return None

    def sad(pos):
        return float(np.mean(np.abs(sig[pos:pos + strip] - ref)))

    coarse = [(sad(p), p) for p in range(lo, hi + 1, 3)]
    coarse.sort()
    best_s, best_p = coarse[0]
    for p in range(max(lo, best_p - 3), min(hi, best_p + 3) + 1):
        s = sad(p)
        if s < best_s:
            best_s, best_p = s, p
    if best_s > 10.0:
        return None
    far = [s for s, p in coarse if abs(p - best_p) >= 12]
    if far and min(far) < best_s * 1.35 + 1.0:
        return None  # ambiguous: repeated content
    return best_p


def utterance_state(uid):
    """True while the daemon is still speaking this very utterance."""
    try:
        cur = json.loads((RUNTIME / "utterance").read_text())
        if cur.get("id") != uid:
            return False
    except (OSError, ValueError):
        return False
    try:
        return (RUNTIME / "state").read_text().strip() == "speaking"
    except OSError:
        return False


def follow(uid, window, arr, spoken, sel_text, tess_lang, img_boxes, backend):
    """Keep the boxes honest for the rest of the utterance: track scrolling
    by row signature, re-fit a moved selection, clear when the text leaves
    the screen, and keep trying when nothing has been found yet. Ticks are
    quick while things move and lazy once the screen has settled, and each
    quiet check captures only the tracked strip, not the whole window."""
    import numpy as np
    ref = r0 = None
    shown = bool(img_boxes)
    ocr_budget = 2
    tick = 0
    calm = 0
    dy = 0.0
    grid_dead = False
    grid_misses = 0
    height_img = int(window["h"] * window["scale"])
    radius = 460

    def anchor(gray_now):
        nonlocal ref, r0
        if not img_boxes:
            ref = None
            return
        top = int(max(0, min(b["y"] for b in img_boxes) - 40))
        bottom = int(min(gray_now.shape[0], max(b["y"] + b["h"] for b in img_boxes) + 40))
        sig = signature(gray_now, np)
        ref, r0 = sig[top:bottom].copy(), top

    anchor(to_gray(arr))

    while utterance_state(uid):
        time.sleep(0.35 if calm < 3 else 0.9)
        tick += 1
        if not utterance_state(uid):
            break
        now = window_by_address(window["address"])
        if now is None:
            if shown:
                emit(uid, False, error="window gone")
            return
        resized = abs(now["w"] - window["w"]) > 2 or abs(now["h"] - window["h"]) > 2
        window = now
        height_img = int(window["h"] * window["scale"])

        # The window's own text (terminal grid or accessibility tree) beats
        # every pixel method: exact, fast, and fresh even while the window
        # streams or scrolls. Re-read it per tick. Ghostty's grid rides the
        # clipboard, so it is not re-read per tick; its boxes fall back to
        # signature tracking below instead.
        if backend in ("grid", "tree") and not grid_dead \
                and (backend == "tree"
                     or _proc_comm(window.get("pid")) in ("foot", "footclient")):
            if not window_focused(window["address"]):
                calm += 1
                continue  # keys must not land in some other window
            words = foot_grid_words(window) if backend == "grid" else tree_words(window)
            if words:
                grid_misses = 0
                boxes2 = fill_gaps(strip_tags(drop_outliers(align(spoken, words))), spoken)
                if backend == "tree" and len(boxes2) < 0.8 * len(img_boxes):
                    # An asynchronously thinner tree snapshot is noise, not
                    # a change; keep the standing boxes.
                    calm += 1
                    continue
                if len(boxes2) >= 8 or len(boxes2) / max(1, len(spoken)) >= 0.5:
                    if boxes2 != img_boxes:
                        calm = 0
                        img_boxes = boxes2
                        emit(uid, True, backend=backend, boxes=to_layout(img_boxes, window),
                             matched=len(img_boxes), total=len(spoken))
                        shown = True
                    else:
                        calm += 1
                    continue
                # The words scrolled out of the visible text: hide rather
                # than guess, and keep watching for their return.
                if shown:
                    emit(uid, False, error="text left the view")
                    shown = False
                img_boxes = []
                calm = 0
                continue
            grid_misses += 1
            if grid_misses < 2:
                continue
            grid_dead = True  # binding gone or window replaced; fall back

        # A partial cursor-band result gets one full pass to complete it.
        upgrade = backend == "ocr-partial" and ocr_budget > 0

        moved = None
        if ref is not None and not resized and not upgrade:
            band0 = int(max(0, r0 + dy - radius))
            band1 = int(min(height_img, r0 + dy + ref.shape[0] + radius))
            strip = screenshot(window, (band0, band1))
            if strip is None:
                continue
            sig = signature(to_gray(strip), np)
            pos = find_shift(ref, sig, r0 + dy - band0, np, radius=radius + 40)
            if pos is not None:
                moved = band0 + pos - r0

        if moved is not None:
            if abs(moved - dy) > 1 or tick == 1:
                calm = 0
                dy = float(moved)
                shifted = [{**b, "y": b["y"] + dy} for b in img_boxes]
                emit(uid, True, backend=backend, boxes=to_layout(shifted, window),
                     matched=len(shifted), total=len(spoken))
                shown = True
            else:
                calm += 1
            continue

        # Track lost (scrolled far, content changed, window resized), a
        # partial result to upgrade, or nothing acquired yet: re-acquire on
        # a full capture. The selection detector is cheap and runs every
        # time; OCR is rationed.
        calm = 0
        arr = screenshot(window)
        if arr is None:
            continue
        timings: dict = {}
        allow_ocr = upgrade or (ocr_budget > 0 and tick % 4 == 2)
        boxes, got = acquire(arr, window, spoken, sel_text, tess_lang, None,
                             allow_ocr, timings,
                             try_grid=not grid_dead and window_focused(window["address"]))
        if allow_ocr and "ocr" in timings:
            ocr_budget -= 1
        if boxes and (not upgrade or len(boxes) >= len(img_boxes)):
            img_boxes = boxes
            backend = got
            dy = 0.0
            anchor(to_gray(arr))
            emit(uid, True, backend=backend, boxes=to_layout(img_boxes, window),
                 matched=len(img_boxes), total=len(spoken), timings=timings)
            shown = True
        elif upgrade:
            backend = "ocr"  # the partial fix stands; do not retry forever
        elif not boxes and shown:
            emit(uid, False, error="tracking lost")
            shown = False


def main() -> int:
    ensure_session_env()
    args = sys.argv[1:]
    image = origin = sel_override = None
    scale = 1.0
    following = False
    while args:
        arg = args.pop(0)
        if arg == "--image" and args:
            image = Path(args.pop(0))
        elif arg == "--origin" and args:
            origin = tuple(float(v) for v in args.pop(0).split(","))
        elif arg == "--scale" and args:
            scale = float(args.pop(0))
        elif arg == "--selection" and args:
            sel_override = Path(args.pop(0))
        elif arg == "--follow":
            following = True
        elif arg == "--grab":
            # "Read from here": print the focused window's own text from
            # the word under the pointer onward, and touch nothing else.
            # --at X,Y (testing) stands in for the pointer position.
            override = None
            if args and args[0] == "--at" and len(args) >= 2:
                args.pop(0)
                override = tuple(float(v) for v in args.pop(0).split(","))
            if image is not None:
                try:
                    arr = load_pnm(image)
                except ImportError:
                    arr = None
                if arr is None:
                    print(json.dumps({"ok": False, "error": "could not read the image"}))
                    return 0
                window = {"x": (origin or (0.0, 0.0))[0], "y": (origin or (0.0, 0.0))[1],
                          "w": arr.shape[1] / scale, "h": arr.shape[0] / scale,
                          "scale": scale, "address": None, "pid": None, "title": None}
            else:
                window = focused_window()
            cursor = override or cursor_pos()
            if window is None or cursor is None:
                print(json.dumps({"ok": False, "error": "no focused window"}))
                return 0
            text, source, hint = grab_text(window, cursor, image=image)
            reply = {"ok": bool(text)}
            if text:
                reply.update(source=source, text=text)
            else:
                reply["error"] = source
            if hint:
                reply["hint"] = hint
            print(json.dumps(reply))
            return 0
        elif arg in ("-h", "--help"):
            print(__doc__)
            return 0

    try:
        utterance = json.loads((RUNTIME / "utterance").read_text())
    except (OSError, ValueError):
        emit(None, False, error="no current utterance")
        return 0
    uid = utterance.get("id")
    text = str(utterance.get("text") or "")
    lang = str(utterance.get("lang") or "en")
    if not text:
        emit(uid, False, error="empty utterance")
        return 0
    spoken = [(m.start(), m.end(), norm(m.group()))
              for m in re.finditer(r"\S+", text)]
    spoken = [t for t in spoken if t[2]]
    if not spoken:
        emit(uid, False, error="nothing to match")
        return 0

    timings: dict = {}
    sel_text = read_primary_selection(sel_override)
    tess_lang = tess_language(lang)

    if image is not None:
        # Test mode: one shot against a fixed image, no follow.
        arr = None
        try:
            arr = load_pnm(image)
        except ImportError:
            pass
        if arr is None:
            emit(uid, False, error="could not read the screenshot")
            return 0
        origin = origin or (0.0, 0.0)
        window = {"x": origin[0], "y": origin[1], "scale": scale,
                  "w": arr.shape[1] / scale, "h": arr.shape[0] / scale, "address": None}
        boxes, backend = acquire(arr, window, spoken, sel_text, tess_lang,
                                 None, True, timings, try_grid=False)
        if boxes:
            emit(uid, True, backend=backend, boxes=to_layout(boxes, window),
                 matched=len(boxes), total=len(spoken), timings=timings)
        else:
            emit(uid, False, error=backend, timings=timings)
        return 0

    t0 = time.time()
    window = focused_window()
    timings["window"] = round(time.time() - t0, 2)
    if window is None:
        emit(uid, False, error="no focused window")
        return 0
    cursor = cursor_pos()
    cursor_img_y = None
    if cursor is not None and window["y"] <= cursor[1] <= window["y"] + window["h"]:
        cursor_img_y = (cursor[1] - window["y"]) * window["scale"]
    t0 = time.time()
    arr = screenshot(window)
    timings["shot"] = round(time.time() - t0, 2)
    if arr is None:
        emit(uid, False, error="screenshot failed")
        return 0
    try:
        boxes, backend = acquire(arr, window, spoken, sel_text, tess_lang,
                                 cursor_img_y, True, timings)
    except ImportError:
        emit(uid, False, error="numpy is not available to /usr/bin/python3")
        return 0
    if boxes:
        emit(uid, True, backend=backend, boxes=to_layout(boxes, window),
             matched=len(boxes), total=len(spoken), timings=timings)
    else:
        emit(uid, False, error=backend, timings=timings)
        backend = None
        boxes = []
    if following:
        follow(uid, window, arr, spoken, sel_text, tess_lang, boxes, backend)
    return 0


if __name__ == "__main__":
    sys.exit(main())
