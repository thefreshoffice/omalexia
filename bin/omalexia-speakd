#!/usr/bin/python3
"""omalexia-speakd: persistent, local text-to-speech daemon.

Keeps the Piper voices loaded in memory so that speech starts within about a
tenth of a second of a request. Listens on a Unix socket in $XDG_RUNTIME_DIR
and plays audio through PipeWire (pw-play). Nothing leaves the machine.

Protocol: one JSON object per line on the socket, one JSON reply per line.

  {"cmd": "speak", "text": "...", "lang": "auto or an ISO code with a configured voice", "wait": false}
  {"cmd": "stop"}
  {"cmd": "status"}
  {"cmd": "set", "speed": 1.2}
  {"cmd": "reload"}
  {"cmd": "watch"}

With "wait": true the connection stays open until playback finishes (or the
client hangs up, which cancels playback). Speech Dispatcher uses that mode.

"watch" turns the connection into an event stream: one JSON line per event
(start, sentence, word, end) while text is read, timed to the audio so a
client can highlight the word being spoken. The bar plugin uses it for
read-along highlighting; with no watcher connected none of the timing work
happens.

Uses /usr/bin/python3 on purpose: the piper module is installed system-wide
(AUR piper-tts), not in whatever python mise puts first on PATH.
"""

from __future__ import annotations

import fcntl
import json
import os
import queue
import re
import signal
import socket
import struct
import subprocess
import sys
import termios
import threading
import time
import tomllib
from pathlib import Path

HOME = Path.home()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "omalexia"
SOCKET_PATH = RUNTIME / "speakd.sock"
STATE_PATH = RUNTIME / "state"
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "omalexia" / "config.toml"
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "omalexia"
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local" / "share") / "omalexia"
VOICES_DIR = DATA_HOME / "voices"
KOKORO_DIR = DATA_HOME / "kokoro"
SUPERTONIC_DIR = DATA_HOME / "supertonic"
OMNIVOICE_DIR = DATA_HOME / "omnivoice"

DEFAULT_CONFIG = {
    "tts": {
        "speed": 1.0,
        "default_language": "auto",
        # How far the audio a listener HEARS trails the audio handed to the
        # sink: pw-play holdback plus device buffering. Wireless headphones
        # add their radio link on top; the panel's marker-timing slider
        # tunes this by ear.
        "highlight_delay": 0.15,
        "voices": {"en": "en_US-lessac-medium", "nl": "nl_NL-pim-medium"},
        "engines": {},
        "kokoro": {"voice": "af_heart"},
        "supertonic": {"voice": "F1"},
        "omnivoice": {"steps": 16},
    }
}


def log(*args):
    print(*args, file=sys.stderr, flush=True)


# --------------------------------------------------------------------------
# Configuration
# --------------------------------------------------------------------------


def load_config() -> dict:
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    if CONFIG_PATH.exists():
        try:
            user = tomllib.loads(CONFIG_PATH.read_text())
        except Exception as exc:  # noqa: BLE001
            log(f"config: ignoring unreadable {CONFIG_PATH}: {exc}")
            user = {}
        tts = user.get("tts", {})
        for key in ("speed", "default_language", "highlight_delay"):
            if key in tts:
                cfg["tts"][key] = tts[key]
        for key in ("voices", "engines", "kokoro", "supertonic", "omnivoice"):
            if isinstance(tts.get(key), dict):
                cfg["tts"][key].update(tts[key])
    # Runtime overrides (set from the bar panel) beat the file.
    for key, name in (("speed", "speed"), ("highlight_delay", "highlight-delay")):
        state_file = STATE_HOME / name
        if state_file.exists():
            try:
                cfg["tts"][key] = float(state_file.read_text().strip())
            except ValueError:
                pass
    return cfg


# --------------------------------------------------------------------------
# Text preparation
# --------------------------------------------------------------------------

# Language detection: pick among the languages the user has voices for.
# Stage one looks at the script (Cyrillic, Greek, Arabic, ...), which is
# decisive. Stage two scores Latin-script candidates on high-frequency
# function words plus characters that only some orthographies use.

STOPWORDS: dict[str, set[str]] = {k: set(v.split()) for k, v in {
    "en": "the and of to in is it that for you with on are this be as at or was have from not by but we can will all your what into",
    "nl": "de het een en van ik je niet dat die er maar zijn ook voor naar wordt heeft mij hij wij jullie deze omdat wel dan nog aan bij",
    "de": "der die das und ist nicht ein eine ich sie mit auf für von dem den als auch werden wurde über nach durch beim einem einen sind",
    "fr": "le la les des une est et dans que qui pour pas sur avec vous nous ils elle été être cette aux mais donc leur ont",
    "es": "el la los las una es y en que de por para con no se su al como más pero sus este esta son entre",
    "it": "il lo gli le una è che di non per con del della sono anche più come questo questa nella dal degli alla",
    "pt": "o os as um uma é e que não do da em para com por se mais foi são como este esta pelo uns",
    "da": "og det er en at den til ikke med han hun af på var som her også hvad hvor kan skal jeg ind",
    "no": "og det er en at den til ikke med han hun av på var som her også hva hvor kan skal jeg inn",
    "sv": "och det är en att den till inte med han hon av på var som här också vad kan ska jag ett för",
    "fi": "ja on ei se että hän oli mutta kun myös niin tämä ole sitä joka mitä kuin vain jos nyt sen olen",
    "pl": "i w nie się na jest że to z do o jak ale po co dla przez był była jego tym może",
    "cs": "a je se na to že v s nebo jako ale po pro od tak jsem byl bylo jsou už co když jeho",
    "sk": "a je sa na to že v s alebo ako ale po pre od tak som bol bolo sú už čo keď jeho",
    "ro": "și de la în cu nu pe un o este sunt care mai pentru dar din ce sa au fost când după",
    "hu": "a az és nem hogy is egy van volt de ha már csak meg el ki mint még ezt aki mert",
    "tr": "ve bir bu da de için ile ne var yok ama daha çok gibi ben sen biz siz onlar değil kadar",
    "ca": "el la els les una és i que de no per amb del al més com aquest aquesta són també però hi",
    "is": "og að er það ekki en við hann hún þau af á var sem hér einnig hvað hvar getur ég um",
    "lv": "un ir nav ka tas šis ar no par uz bet kā tikai arī jau vēl kad viņš viņa mēs es",
    "lb": "an dat ass net een eng vun mat fir op och nach wéi mee dass hien si mir dir ech",
    "cy": "y yr a i o yn ac mae ar am gyda ddim wedi bod fel ond hyn nhw chi ni eu",
    "sw": "na ya wa ni kwa la za katika hii yake wake kama lakini pia sana tu baada kabla watu wengi",
    "vi": "và của là không có được cho một người này đã với các những khi tôi bạn chúng để về",
}.items()}

# Characters that strongly suggest one orthography over its neighbours.
CHAR_MARKERS: dict[str, str] = {
    "de": "ßäöü", "es": "ñ¿¡", "pt": "ãõç", "fr": "çàèêëœù", "it": "àèìòù",
    "da": "øå", "no": "øå", "sv": "åäö", "fi": "äö",
    "pl": "ąęłżźśćń", "cs": "řěů", "sk": "ľĺŕô", "hu": "őű",
    "ro": "ășțţâî", "tr": "ğşıİ", "is": "þðæ", "lv": "āēīūķļņģš",
    "ca": "çàèò·", "cy": "ŵŷ", "vi": "ạảấầẩậắằẳẵặẹẻẽếềểễệịọỏốồổỗộớờởỡợụủứừửữựỳỵỷỹđơư",
}

# Non-Latin scripts are decisive on their own.
SCRIPT_RANGES = [
    ((0x4E00, 0x9FFF), "zh"), ((0x3040, 0x30FF), "ja"), ((0xAC00, 0xD7AF), "ko"),
    ((0x10A0, 0x10FF), "ka"), ((0x0370, 0x03FF), "el"),
    ((0x0600, 0x06FF), "ar"), ((0x0400, 0x04FF), "ru"),
    ((0x0900, 0x097F), "hi"), ((0x0590, 0x05FF), "he"),
    ((0x0530, 0x058F), "hy"), ((0x0980, 0x09FF), "bn"),
    ((0x0C00, 0x0C7F), "te"), ((0x0D00, 0x0D7F), "ml"),
]


def _script_language(text: str, candidates: list[str]) -> str | None:
    counts: dict[str, int] = {}
    for ch in text:
        cp = ord(ch)
        if cp < 0x0370:
            continue
        for (lo, hi), lang in SCRIPT_RANGES:
            if lo <= cp <= hi:
                counts[lang] = counts.get(lang, 0) + 1
                break
    if not counts:
        return None
    lang = max(counts, key=counts.get)
    if counts[lang] < 3:
        return None
    # Han plus kana means Japanese, not Chinese.
    if lang == "zh" and counts.get("ja") and "ja" in candidates:
        lang = "ja"
    # Cyrillic with Bulgarian in play and no Russian: prefer the candidate.
    if lang == "ru" and "ru" not in candidates and "bg" in candidates:
        lang = "bg"
    # Refine within a shared script.
    if lang == "ar":
        if "fa" in candidates and ("ar" not in candidates or any(c in text for c in "پچژگ")):
            lang = "fa"
        elif "ur" in candidates and ("ar" not in candidates or any(c in text for c in "ٹڈڑںھے")):
            lang = "ur"
    if lang == "ru":
        if "uk" in candidates and any(c in text for c in "іїєґ"):
            lang = "uk"
        elif "kk" in candidates and any(c in text for c in "әғқңөұүһ"):
            lang = "kk"
        elif "sr" in candidates and any(c in text for c in "ђћџљњ"):
            lang = "sr"
        elif "ru" not in candidates:
            lang = next((c for c in ("uk", "sr", "kk") if c in candidates), lang)
    if lang == "hi" and "hi" not in candidates and "ne" in candidates:
        lang = "ne"
    return lang if lang in candidates else None


def detect_language(text: str, fallback: str, candidates: list[str]) -> str:
    if not candidates:
        return fallback
    if fallback not in candidates:
        fallback = candidates[0]
    if len(candidates) == 1:
        return candidates[0]
    by_script = _script_language(text, candidates)
    if by_script:
        return by_script
    lowered = text.lower()
    words = re.findall(r"[^\W\d_]+", lowered, re.UNICODE)
    if not words:
        return fallback
    scores: dict[str, int] = {}
    for lang in candidates:
        score = sum(2 for w in words if w in STOPWORDS.get(lang, ()))
        markers = CHAR_MARKERS.get(lang)
        if markers:
            score += min(sum(lowered.count(c) for c in markers), len(words) // 2)
        # Legacy tie-breakers that work well for the common en/nl pair.
        if lang == "nl":
            score += sum(1 for w in words if "ij" in w) // 2
        if lang == "en":
            score += sum(1 for w in words if w.startswith("th")) // 2
        scores[lang] = score
    best = max(scores, key=scores.get)
    ranked = sorted(scores.values(), reverse=True)
    if ranked[0] == 0 or (len(ranked) > 1 and ranked[0] == ranked[1]):
        return fallback
    return best


URL_RE = re.compile(r"https?://(?:www\.)?([^/\s]+)\S*")
BULLET_RE = re.compile(r"^\s*(?:[-*•▪◦]|\d+[.)])\s+", re.MULTILINE)
HEADING_RE = re.compile(r"^\s*#{1,6}\s+", re.MULTILINE)


def prepare_text(text: str) -> str:
    """Make copied text read well aloud: unwrap hard line breaks, drop
    markdown noise, read URLs as their host name."""
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = URL_RE.sub(r"\1", text)
    text = HEADING_RE.sub("", text)
    text = BULLET_RE.sub("", text)
    text = re.sub(r"[*_`>#|]+", " ", text)
    lines = [ln.rstrip() for ln in text.split("\n")]
    paragraphs: list[str] = []
    out: list[str] = []

    def close_paragraph():
        nonlocal out
        if not out:
            return
        if not re.search(r"[.!?:;…]$", out[-1]):
            out[-1] += "."
        paragraphs.append(" ".join(out))
        out = []

    for ln in lines:
        if not ln.strip():
            # Paragraph break: close the sentence and keep the boundary (a
            # newline in the prepared text), so the reader breathes there
            # the way a human would instead of rushing into the next topic.
            close_paragraph()
            continue
        if out and not re.search(r"[.!?:;…]$", out[-1]):
            out[-1] = out[-1] + " " + ln.strip()
        else:
            out.append(ln.strip())
    close_paragraph()
    text = "\n".join(paragraphs)
    text = re.sub(r"[ \t]+", " ", text).strip()
    return text


SENTENCE_RE = re.compile(r"(?<=[.!?…])\s+")
ABBREVIATIONS = {
    "mr", "mrs", "ms", "dr", "prof", "st", "vs", "etc", "nr", "no", "ca", "approx",
    "dhr", "mevr", "mw", "bv", "o.a", "d.w.z", "e.g", "i.e", "z.b", "bzw", "u.a",
}


def _split_paragraph(text: str) -> list[str]:
    """Split one paragraph into sentences so the daemon can re-read the speed
    between them. Boundaries the engines would find themselves; a wrong split
    only shortens one synthesis call."""
    parts: list[str] = []
    start = 0
    for m in SENTENCE_RE.finditer(text):
        before = text[start:m.start()].rstrip()
        word = before.rsplit(None, 1)[-1] if before else ""
        bare = word.rstrip(".!?…").lower()
        nxt = text[m.end(): m.end() + 1]
        # Not a boundary: known abbreviation, an initial ("J."), or the next
        # word continues in lowercase.
        if bare in ABBREVIATIONS or (len(bare) == 1 and bare.isalpha()) or (nxt and nxt.islower()):
            continue
        if before:
            parts.append(text[start:m.start()].strip())
        start = m.end()
    tail = text[start:].strip()
    if tail:
        parts.append(tail)
    # Glue fragments that are too short to synthesize on their own.
    merged: list[str] = []
    for part in parts:
        if merged and len(part) < 4:
            merged[-1] += " " + part
        else:
            merged.append(part)
    return merged or [text]


def split_sentences(text: str) -> list[tuple[str, bool]]:
    """(sentence, starts_new_paragraph) pairs across the prepared text;
    paragraph boundaries survive as newlines and earn a longer pause."""
    result: list[tuple[str, bool]] = []
    for p_index, para in enumerate(text.split("\n")):
        para = para.strip()
        if not para:
            continue
        for s_index, part in enumerate(_split_paragraph(para)):
            result.append((part, p_index > 0 and s_index == 0))
    return result or [(text, False)]


# A deliberate breath at every paragraph boundary; without it a flattened
# article rushes from one topic into the next.
PARAGRAPH_GAP_MS = 320

# Speeds above ENGINE_SPEED_MAX are produced by synthesizing at 2x and
# time-stretching the audio with ffmpeg's atempo filter (pitch-preserving;
# a single node handles factors up to 2, so 2 x 2 covers the whole range).
# Model-side speed alone cannot do this: kokoro-onnx refuses anything above
# 2.0 and Piper's duration predictor saturates near 2.2x regardless of the
# requested length_scale.
SPEED_MAX = 4.0
ENGINE_SPEED_MAX = 2.0
_atempo_warned = False


def atempo(pcm: bytes, rate: int, factor: float) -> bytes:
    """Time-stretch mono s16 PCM by factor (>1 = faster) without pitch shift."""
    global _atempo_warned
    try:
        result = subprocess.run(
            ["ffmpeg", "-v", "error", "-f", "s16le", "-ar", str(rate), "-ac", "1",
             "-i", "pipe:0", "-filter:a", f"atempo={factor:.4f}",
             "-f", "s16le", "-ar", str(rate), "-ac", "1", "pipe:1"],
            input=pcm, capture_output=True, timeout=30,
        )
        if result.returncode == 0 and result.stdout:
            return result.stdout
    except Exception:  # noqa: BLE001
        pass
    if not _atempo_warned:
        _atempo_warned = True
        log("ffmpeg atempo unavailable; speeds above 2x fall back to 2x")
    return pcm


# --------------------------------------------------------------------------
# Word timing (read-along highlighting)
# --------------------------------------------------------------------------

# Neither engine reports word timestamps, but the daemon knows the exact
# duration of every sentence before its first byte reaches the player. That
# duration is divided over the words in proportion to their phoneme counts
# (espeak-ng, one word per input line so numbers and abbreviations expand
# inside their own line), which keeps the highlight honest within a sentence
# and exact at every sentence boundary. Languages written without spaces
# (Chinese, Japanese) fall back to one span per sentence.

ESPEAK_VOICES = {"no": "nb", "zh": "cmn", "he": "he", "ua": "uk"}


def word_weights(words: list[str], lang: str) -> list[float]:
    """Relative duration of each word: phoneme count when espeak-ng can
    phonemize the language, character count otherwise."""
    bare = [re.sub(r"[\W_]+", "", w, flags=re.UNICODE) for w in words]
    weights = [float(max(2, len(b))) if b else 1.0 for b in bare]
    payload = [(i, b) for i, b in enumerate(bare) if b]
    if payload:
        try:
            r = subprocess.run(
                ["espeak-ng", "-q", "--ipa", "-v", ESPEAK_VOICES.get(lang, lang or "en")],
                input="\n".join(b for _, b in payload) + "\n",
                capture_output=True, text=True, timeout=5,
            )
            out = [ln.strip() for ln in r.stdout.split("\n") if ln.strip()]
            if r.returncode == 0 and len(out) == len(payload):
                for (i, _), ipa in zip(payload, out):
                    weights[i] = float(max(2, sum(1 for c in ipa if c not in " ˈˌː")))
        except Exception:  # noqa: BLE001
            pass
    # A word before a comma-class pause owns that pause's time too.
    for i, w in enumerate(words):
        if w[-1:] in ",;:":
            weights[i] += 4.0
    return weights


def silence_bounds(pcm: bytes, rate: int) -> tuple[float, float]:
    """Seconds of near-silence the model renders before and after the speech;
    words are distributed over what is left."""
    try:
        import numpy as np
    except Exception:  # noqa: BLE001
        return 0.0, 0.0
    samples = np.frombuffer(pcm, dtype=np.int16).astype(np.int32)
    loud = np.flatnonzero(np.abs(samples) > 330)
    if loud.size == 0:
        return 0.0, 0.0
    return float(loud[0]) / rate, float(samples.size - 1 - loud[-1]) / rate


def schedule_words(events: "queue.Queue", uid: int, sentence: str, offset: int,
                   index: int, count: int, base: float, pcm: bytes, rate: int,
                   lang: str):
    """Queue the sentence and word events for one sentence that starts at
    char `offset` of the utterance and whose audio starts `base` seconds in.
    All char offsets in the events are global (into the prepared text)."""
    duration = len(pcm) / 2 / rate
    if duration <= 0:
        return
    events.put((base, {"event": "sentence", "id": uid, "index": index,
                       "count": count, "start": offset,
                       "end": offset + len(sentence), "text": sentence}))
    spans = [(m.start(), m.end()) for m in re.finditer(r"\S+", sentence)]
    if not spans:
        return
    weights = word_weights([sentence[s:e] for s, e in spans], lang)
    lead, trail = silence_bounds(pcm, rate)
    speech = max(0.05, duration - lead - trail)
    total = sum(weights) or 1.0
    acc = 0.0
    for (s, e), w in zip(spans, weights):
        events.put((base + lead + speech * (acc / total),
                    {"event": "word", "id": uid,
                     "start": offset + s, "end": offset + e}))
        acc += w


# --------------------------------------------------------------------------
# Engines
# --------------------------------------------------------------------------


class PiperEngine:
    name = "piper"

    def __init__(self, voice_name: str):
        from piper import PiperVoice  # imported lazily so --help works without it

        model = VOICES_DIR / f"{voice_name}.onnx"
        if not model.exists():
            raise FileNotFoundError(f"voice not installed: {voice_name} ({model})")
        t = time.time()
        self.voice = PiperVoice.load(str(model))
        self.rate = self.voice.config.sample_rate
        self.voice_name = voice_name
        log(f"piper: loaded {voice_name} in {time.time() - t:.2f}s ({self.rate} Hz)")

    def synthesize(self, text: str, speed: float, cancel: threading.Event):
        from piper import SynthesisConfig

        cfg = SynthesisConfig(length_scale=1.0 / max(0.4, min(2.5, speed)))
        for chunk in self.voice.synthesize(text, cfg):
            if cancel.is_set():
                return
            yield chunk.audio_int16_bytes


# Languages the Kokoro-82M model actually ships voices for, with the kokoro
# lang code and a good default voice each. English resolves its lang from
# the voice prefix (af_/bf_).
KOKORO_LANGS = {
    "en": ("en-us", "af_heart"),
    "es": ("es", "ef_dora"),
    "fr": ("fr-fr", "ff_siwis"),
    "hi": ("hi", "hf_alpha"),
    "it": ("it", "if_sara"),
    "ja": ("ja", "jf_alpha"),
    "pt": ("pt-br", "pf_dora"),
    "zh": ("cmn", "zf_xiaoxiao"),
}


class KokoroWorker:
    """One Kokoro-82M worker process, shared by every Kokoro language so a
    second language does not cost a second 300 MB model."""

    _instance = None
    _instance_lock = threading.Lock()

    @classmethod
    def shared(cls):
        with cls._instance_lock:
            if cls._instance is None or cls._instance.proc.poll() is not None:
                cls._instance = cls()
            return cls._instance

    def __init__(self):
        python = KOKORO_DIR / ".venv" / "bin" / "python"
        worker = KOKORO_DIR / "worker.py"
        if not python.exists() or not worker.exists():
            raise FileNotFoundError("kokoro is not installed (run: omalexia voice install kokoro)")
        self.proc = subprocess.Popen(
            [str(python), str(worker)],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=sys.stderr,
            cwd=KOKORO_DIR,
        )
        self.lock = threading.Lock()
        line = self.proc.stdout.readline()
        if not line.startswith(b"ready"):
            raise RuntimeError("kokoro worker failed to start")
        log("kokoro: worker ready")


class KokoroEngine:
    """Kokoro-82M for one language, through the shared worker process
    (its venv has Python 3.12 and its own onnxruntime)."""

    name = "kokoro"
    gap_ms = 80  # per-sentence calls lose the ~0.21 s pause the model renders

    def __init__(self, voice: str, lang: str = "en"):
        default_lang, default_voice = KOKORO_LANGS.get(lang, KOKORO_LANGS["en"])
        self.voice_name = voice or default_voice
        if lang == "en":
            self.lang = "en-gb" if self.voice_name.startswith("b") else "en-us"
        else:
            self.lang = default_lang
        self.rate = 24000
        self.worker = KokoroWorker.shared()
        log(f"kokoro: engine for {lang} ({self.voice_name}, {self.lang})")

    @property
    def proc(self):
        # reload()/eviction kill engines via .proc; the shared worker dies
        # with the last engine holding it, and shared() restarts it on need.
        return self.worker.proc

    def synthesize(self, text: str, speed: float, cancel: threading.Event):
        req = json.dumps({"text": text, "voice": self.voice_name, "speed": speed, "lang": self.lang})
        worker = self.worker
        if worker.proc.poll() is not None:
            worker = self.worker = KokoroWorker.shared()
        with worker.lock:
            worker.proc.stdin.write(req.encode() + b"\n")
            worker.proc.stdin.flush()
            while True:
                header = worker.proc.stdout.read(4)
                if len(header) < 4:
                    return
                n = int.from_bytes(header, "little")
                if n == 0:
                    return
                data = worker.proc.stdout.read(n)
                if cancel.is_set():
                    # Drain the rest so the worker stays in sync.
                    continue
                yield data


# Languages Supertonic 3 ships (31, from the model card).
SUPERTONIC_LANGS = set(
    "ar bg cs da de el en es et fi fr hi hr hu id it ja ko lt lv nl pl pt "
    "ro ru sk sl sv tr uk vi".split())


class EngineWorker:
    """One long-lived worker subprocess per heavy engine (Supertonic,
    OmniVoice), shared across languages so a second language does not cost
    a second model. Same stdin/stdout protocol as the Kokoro worker; the
    ready line may carry the PCM sample rate."""

    _instances: dict[str, "EngineWorker"] = {}
    _instances_lock = threading.Lock()

    @classmethod
    def shared(cls, kind: str, directory: Path, default_rate: int):
        with cls._instances_lock:
            inst = cls._instances.get(kind)
            if inst is None or inst.proc.poll() is not None:
                inst = cls._instances[kind] = cls(kind, directory, default_rate)
            return inst

    def __init__(self, kind: str, directory: Path, default_rate: int):
        python = directory / ".venv" / "bin" / "python"
        worker = directory / "worker.py"
        if not python.exists() or not worker.exists():
            raise FileNotFoundError(
                f"{kind} is not installed (run: omalexia voice install {kind})")
        self.proc = subprocess.Popen(
            [str(python), str(worker)],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=sys.stderr,
            cwd=directory,
        )
        self.lock = threading.Lock()
        line = self.proc.stdout.readline()
        if not line.startswith(b"ready"):
            raise RuntimeError(f"{kind} worker failed to start")
        parts = line.split()
        self.rate = int(parts[1]) if len(parts) > 1 else default_rate
        log(f"{kind}: worker ready ({self.rate} Hz)")


class WorkerEngine:
    """Engine for one language, backed by a shared EngineWorker."""

    name = ""
    directory: Path
    default_rate = 24000
    gap_ms = 0

    def __init__(self, voice: str | None, lang: str, extra: dict | None = None):
        self.voice_name = voice or ""
        self.lang = lang
        self.extra = extra or {}
        self.worker = EngineWorker.shared(self.name, self.directory, self.default_rate)
        self.rate = self.worker.rate
        log(f"{self.name}: engine for {lang}" + (f" ({voice})" if voice else ""))

    @property
    def proc(self):
        # reload()/eviction kill engines via .proc; the shared worker dies
        # with the last engine holding it, and shared() restarts it on need.
        return self.worker.proc

    def synthesize(self, text: str, speed: float, cancel: threading.Event):
        req = json.dumps({"text": text, "voice": self.voice_name, "speed": speed,
                          "lang": self.lang, **self.extra})
        worker = self.worker
        if worker.proc.poll() is not None:
            worker = self.worker = EngineWorker.shared(
                self.name, self.directory, self.default_rate)
            self.rate = worker.rate
        with worker.lock:
            worker.proc.stdin.write(req.encode() + b"\n")
            worker.proc.stdin.flush()
            while True:
                header = worker.proc.stdout.read(4)
                if len(header) < 4:
                    return
                n = int.from_bytes(header, "little")
                if n == 0:
                    return
                data = worker.proc.stdout.read(n)
                if cancel.is_set():
                    # Drain the rest so the worker stays in sync.
                    continue
                yield data


class SupertonicEngine(WorkerEngine):
    """Supertonic 3 (99M flow matching, 31 languages, real time on CPU)."""

    name = "supertonic"
    directory = SUPERTONIC_DIR
    default_rate = 44100
    gap_ms = 40


class OmniVoiceEngine(WorkerEngine):
    """OmniVoice 0.6B (646 languages); needs a GPU backend to be real time."""

    name = "omnivoice"
    directory = OMNIVOICE_DIR
    default_rate = 24000
    gap_ms = 60


# --------------------------------------------------------------------------
# Player
# --------------------------------------------------------------------------


class Player:
    def __init__(self, rate: int):
        self.rate = rate
        self.written = 0
        self.proc = subprocess.Popen(
            ["pw-play", "--raw", "--format", "s16", "--rate", str(rate), "--channels", "1",
             "--media-role", "Accessibility", "-"],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        # The default 64 KB pipe holds well under a second of audio, less
        # than one sentence takes to synthesize, which turns every sentence
        # boundary into an audible stall. Grow it; _run paces the lead.
        try:
            fcntl.fcntl(self.proc.stdin.fileno(), fcntl.F_SETPIPE_SZ, 512 * 1024)
        except OSError:
            pass

    def write(self, data: bytes) -> bool:
        try:
            self.proc.stdin.write(data)
            self.proc.stdin.flush()
            self.written += len(data)
            return True
        except (BrokenPipeError, ValueError):
            return False

    def consumed_seconds(self) -> float | None:
        """Seconds of audio pw-play has actually taken from the pipe: the
        closed-loop half of the highlight clock. If playback ever stalls,
        this stalls with it, and the word events wait instead of drifting
        ahead of the voice."""
        try:
            raw = fcntl.ioctl(self.proc.stdin.fileno(), termios.FIONREAD, b"\x00\x00\x00\x00")
            pending = struct.unpack("i", raw)[0]
        except (OSError, struct.error, ValueError):
            return None
        return (self.written - pending) / 2 / self.rate

    def finish(self):
        try:
            self.proc.stdin.close()
        except Exception:  # noqa: BLE001
            pass
        self.proc.wait()

    def kill(self):
        try:
            self.proc.kill()
        except Exception:  # noqa: BLE001
            pass
        try:
            self.proc.stdin.close()
        except Exception:  # noqa: BLE001
            pass


# --------------------------------------------------------------------------
# Daemon
# --------------------------------------------------------------------------


class Daemon:
    def __init__(self):
        self.config = load_config()
        self.engines: dict[str, object] = {}
        self.lock = threading.Lock()
        self.cancel = threading.Event()
        self.worker: threading.Thread | None = None
        self.player: Player | None = None
        self.current: dict = {}
        self.utterance_id = 0
        self.done = threading.Condition()
        self.watchers: list[tuple[socket.socket, bool]] = []  # (conn, wants boxes)
        self.watch_lock = threading.Lock()
        self.set_state("idle")

    # -- state -------------------------------------------------------------

    def set_state(self, state: str):
        # Written in place (not atomically renamed) so inotify watchers on
        # the path (the bar plugin, `omalexia-say follow`) keep their watch.
        RUNTIME.mkdir(parents=True, exist_ok=True)
        with open(STATE_PATH, "w") as f:
            f.write(state + "\n")

    def status(self) -> dict:
        speaking = self.worker is not None and self.worker.is_alive()
        return {
            "state": "speaking" if speaking else "idle",
            "speed": self.config["tts"]["speed"],
            "highlightDelay": self.config["tts"].get("highlight_delay", 0.15),
            "voices": self.config["tts"]["voices"],
            "engines": {lang: getattr(e, "name", "?") for lang, e in self.engines.items()},
            "text": self.current.get("text", "")[:120] if speaking else "",
        }

    def emit(self, event: dict):
        """Send one event line to every watcher; a watcher that cannot keep
        up (send timeout) or has hung up is dropped."""
        if not self.watchers:
            return
        data = (json.dumps(event) + "\n").encode()
        with self.watch_lock:
            for entry in self.watchers[:]:
                try:
                    entry[0].sendall(data)
                except Exception:  # noqa: BLE001
                    self.watchers.remove(entry)
                    try:
                        entry[0].close()
                    except Exception:  # noqa: BLE001
                        pass

    # -- engines -----------------------------------------------------------

    MAX_WARM_ENGINES = 3

    def engine_for(self, lang: str):
        if lang in self.engines:
            # Move to the end: most recently used.
            self.engines[lang] = self.engines.pop(lang)
            return self.engines[lang]
        tts = self.config["tts"]
        wanted = tts["engines"].get(lang, "piper")
        engine = None
        if wanted == "kokoro" and lang in KOKORO_LANGS:
            kokoro_voice = tts["kokoro"].get(lang) or (
                tts["kokoro"].get("voice") if lang == "en" else None)
            try:
                engine = KokoroEngine(kokoro_voice, lang)
            except Exception as exc:  # noqa: BLE001
                log(f"kokoro unavailable, falling back to piper: {exc}")
        elif wanted == "omnivoice":
            steps = tts["omnivoice"].get("steps", 16)
            try:
                engine = OmniVoiceEngine(None, lang, extra={"steps": steps})
            except Exception as exc:  # noqa: BLE001
                log(f"omnivoice unavailable, falling back: {exc}")
                wanted = "supertonic"  # best remaining quality, if installed
        if engine is None and wanted == "supertonic":
            if lang in SUPERTONIC_LANGS:
                voice = tts["supertonic"].get(lang) or tts["supertonic"].get("voice")
                try:
                    engine = SupertonicEngine(voice, lang)
                except Exception as exc:  # noqa: BLE001
                    log(f"supertonic unavailable, falling back to piper: {exc}")
            else:
                log(f"supertonic does not speak '{lang}'; falling back to piper")
        if engine is None:
            voice = tts["voices"].get(lang)
            if not voice:
                raise FileNotFoundError(f"no voice configured for language '{lang}'")
            engine = PiperEngine(voice)
        self.engines[lang] = engine
        # With many languages configured, keep only the most recently used
        # voices in memory; never evict the one that is speaking right now.
        active = self.current.get("lang")
        while len(self.engines) > self.MAX_WARM_ENGINES:
            victims = [k for k in self.engines if k not in (lang, active)]
            # A voice with a worker process (Kokoro) is expensive to bring
            # back; evict the in-process Piper voices first.
            victim = next((k for k in victims
                           if getattr(self.engines[k], "proc", None) is None),
                          victims[0] if victims else None)
            if victim is None:
                break
            dropped = self.engines.pop(victim)
            proc = getattr(dropped, "proc", None)
            if proc is not None:
                try:
                    proc.terminate()
                except Exception:  # noqa: BLE001
                    pass
            log(f"unloaded {victim} voice (keeping {self.MAX_WARM_ENGINES} warm)")
        return engine

    def preload(self):
        """Warm the most likely voices; the rest load on first use (~1 s)."""
        tts = self.config["tts"]
        langs = list(tts["voices"])
        default = tts["default_language"]
        if default in langs:
            langs.remove(default)
            langs.insert(0, default)
        for lang in langs[: self.MAX_WARM_ENGINES]:
            try:
                self.engine_for(lang)
            except Exception as exc:  # noqa: BLE001
                log(f"preload {lang}: {exc}")

    def reload(self):
        self.stop()
        with self.lock:
            old_tts = self.config["tts"]
            self.config = load_config()
            tts = self.config["tts"]
            kept: dict[str, object] = {}
            for lang, engine in self.engines.items():
                unchanged = (
                    lang in tts["voices"]
                    and tts["voices"].get(lang) == old_tts["voices"].get(lang)
                    and tts["engines"].get(lang, "piper") == old_tts["engines"].get(lang, "piper")
                    and (tts["engines"].get(lang) != "kokoro" or tts["kokoro"] == old_tts["kokoro"])
                    and (tts["engines"].get(lang) != "supertonic"
                         or tts["supertonic"] == old_tts["supertonic"])
                    and (tts["engines"].get(lang) != "omnivoice"
                         or tts["omnivoice"] == old_tts["omnivoice"])
                )
                if unchanged:
                    kept[lang] = engine
                    continue
                proc = getattr(engine, "proc", None)
                if proc is not None:
                    proc.kill()
                log(f"reload: dropping {lang} voice (configuration changed)")
            self.engines = kept
        self.preload()

    # -- speaking ----------------------------------------------------------

    def _cancel_locked(self) -> threading.Thread | None:
        """Cancel the current utterance. Must be called with the lock held;
        returns the old worker so the caller can join it *outside* the lock
        (the worker needs the lock to finish)."""
        self.cancel.set()
        if self.player is not None:
            self.player.kill()
        worker = self.worker
        self.worker = None
        self.player = None
        self.cancel = threading.Event()
        self.set_state("idle")
        return worker

    def stop(self):
        with self.lock:
            worker = self._cancel_locked()
        if worker is not None and worker.is_alive():
            worker.join(timeout=2)

    def speak(self, text: str, lang: str, speed: float | None = None) -> dict:
        text = prepare_text(text)
        if not text:
            return {"ok": False, "error": "nothing to read"}
        tts = self.config["tts"]
        if lang in ("", "auto", None):
            fallback = tts["default_language"] if tts["default_language"] != "auto" else "en"
            lang = detect_language(text, fallback, list(tts["voices"]))
        if lang not in tts["voices"]:
            lang = next(iter(tts["voices"]))
        try:
            engine = self.engine_for(lang)
        except Exception as exc:  # noqa: BLE001
            return {"ok": False, "error": str(exc)}

        with self.lock:
            old = self._cancel_locked()
            self.utterance_id += 1
            uid = self.utterance_id
            cancel = self.cancel
            self.current = {"text": text, "lang": lang, "id": uid}
            # The prepared text, on disk, so tools that react to the event
            # stream (omalexia-locate) see exactly the text the offsets in
            # the word events refer to.
            try:
                (RUNTIME / "utterance").write_text(
                    json.dumps({"id": uid, "lang": lang, "text": text}))
            except OSError:
                pass
            # No explicit speed: follow the live setting, re-read between
            # sentences so `set` changes apply mid-text.
            if speed is not None:
                speed = max(0.5, min(SPEED_MAX, float(speed)))
            thread = threading.Thread(
                target=self._run, args=(engine, text, speed, cancel, uid), daemon=True
            )
            self.worker = thread
            self.set_state("speaking")
            thread.start()
        if old is not None and old.is_alive():
            old.join(timeout=2)
        # With a box watcher on the line, find the words on screen while
        # the first sentence synthesizes and keep following them for the
        # whole utterance (scrolling, window moves).
        if any(wants for _, wants in self.watchers):
            threading.Thread(target=self._locate, args=(uid, cancel), daemon=True).start()
        return {"ok": True, "id": uid, "lang": lang, "engine": engine.name, "chars": len(text)}

    LOCATE_TOOL = HOME / ".local" / "bin" / "omalexia-locate"

    def _locate(self, uid: int, cancel: threading.Event):
        """Stream on-screen word boxes from `omalexia-locate --follow`: an
        initial fix, then an update whenever the text moves or is lost from
        view. The tool watches the utterance and state files and exits by
        itself when this utterance is over."""
        tool = str(self.LOCATE_TOOL) if self.LOCATE_TOOL.exists() else "omalexia-locate"
        try:
            proc = subprocess.Popen([tool, "--follow"], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL)
        except Exception as exc:  # noqa: BLE001
            log(f"locate: {exc}")
            return
        try:
            for raw in proc.stdout:
                if cancel.is_set() or self.utterance_id != uid:
                    break
                try:
                    reply = json.loads(raw.decode("utf-8", "replace"))
                except ValueError:
                    continue
                if reply.get("id") != uid:
                    continue
                boxes = (reply.get("boxes") or []) if reply.get("ok") else []
                event = {"event": "boxes", "id": uid, "matched": reply.get("matched"),
                         "total": reply.get("total"), "boxes": boxes}
                with self.lock:
                    if self.utterance_id == uid:
                        self.current["boxes"] = event
                self.emit(event)
                log(f"locate: {reply.get('backend') or reply.get('error') or '?'}, "
                    f"{len(boxes)} boxes {reply.get('t') or ''}")
        finally:
            try:
                proc.terminate()
            except Exception:  # noqa: BLE001
                pass

    def _run(self, engine, text: str, speed: float | None, cancel: threading.Event, uid: int):
        player = None
        emitter = None
        emitter_stop = threading.Event()
        events: queue.Queue = queue.Queue()
        clock = {"start": None}  # monotonic time of the first byte written
        try:
            player = Player(engine.rate)
            with self.lock:
                if cancel.is_set():
                    player.kill()
                    return
                self.player = player
            last_speed = None
            gap_ms = getattr(engine, "gap_ms", 0)
            queued = 0.0    # seconds of audio handed to the player
            lead_max = 4.0  # buffer this far ahead; also the ceiling on how
                            # long a mid-text speed change can take to apply
            pending: list[bytes] = []
            prebuffer = 1.5  # seconds in hand before the first byte plays: a
                             # short first sentence no longer runs dry while
                             # the second one is still synthesizing

            def write_paced(pcm: bytes, hold: bool = False) -> bool:
                nonlocal queued, pending
                if clock["start"] is None:
                    pending.append(pcm)
                    queued += len(pcm) / 2 / engine.rate
                    if hold and queued < prebuffer:
                        return True
                    data = b"".join(pending)
                    pending = []
                    if cancel.is_set() or (data and not player.write(data)):
                        return False
                    clock["start"] = time.monotonic()
                    return True
                while not cancel.is_set():
                    lead = queued - (time.monotonic() - clock["start"])
                    if lead < lead_max:
                        break
                    cancel.wait(min(lead - lead_max, 0.2))
                if cancel.is_set() or not player.write(pcm):
                    return False
                queued += len(pcm) / 2 / engine.rate
                return True

            # Highlight events ride the same clock as the audio: each event
            # is stamped with its playback time when the sentence is queued,
            # and this thread emits it at that moment. The moment is judged
            # twice: by wall time since the first write AND by how much
            # audio pw-play has actually consumed, so a playback stall holds
            # the events back instead of letting them run ahead. On top sits
            # the configurable highlight delay: the lag between audio handed
            # to the sink and audio heard (wireless headphones add plenty).
            def emit_due():
                while True:
                    item = events.get()
                    if item is None:
                        return
                    at, event = item
                    while clock["start"] is None:
                        if cancel.is_set() or emitter_stop.is_set():
                            return
                        cancel.wait(0.05)
                    delay = float(self.config["tts"].get("highlight_delay", 0.15))
                    target = max(0.0, at + max(-0.3, min(1.5, delay)))
                    while not cancel.is_set() and not emitter_stop.is_set():
                        wall_gap = clock["start"] + target - time.monotonic()
                        if wall_gap > 0:
                            cancel.wait(min(wall_gap, 0.2))
                            continue
                        played = player.consumed_seconds()
                        if played is not None and played < min(at, queued):
                            cancel.wait(min(max((at - played) * 0.5, 0.02), 0.2))
                            continue
                        break
                    if cancel.is_set() or emitter_stop.is_set():
                        return
                    self.emit(event)

            emitter = threading.Thread(target=emit_due, daemon=True)
            emitter.start()
            lang = self.current.get("lang", "")
            self.emit({"event": "start", "id": uid, "lang": lang, "chars": len(text)})

            sentences = split_sentences(text)
            pos = 0
            for index, (sentence, new_paragraph) in enumerate(sentences):
                if cancel.is_set():
                    break
                offset = text.find(sentence, pos)
                if offset < 0:
                    offset = pos
                pos = offset + len(sentence)
                now = speed if speed is not None else float(self.config["tts"]["speed"])
                if last_speed is not None and now != last_speed:
                    log(f"speed {last_speed} -> {now} mid-utterance")
                if last_speed is not None:
                    # The regular seam pause the engine loses to per-sentence
                    # calls, plus a deliberate breath at a paragraph break.
                    pause_ms = gap_ms + (PARAGRAPH_GAP_MS if new_paragraph else 0)
                    if pause_ms:
                        pause = b"\x00\x00" * int(engine.rate * pause_ms / 1000 / now)
                        if not write_paced(pause, hold=True):
                            cancel.set()
                            break
                last_speed = now
                engine_speed = min(now, ENGINE_SPEED_MAX)
                stretch = now / engine_speed
                # One sentence, one buffer. Both engines deliver a sentence
                # as a single chunk anyway, and knowing the exact duration
                # before the first byte is written is what keeps the word
                # highlight honest.
                pcm = b"".join(engine.synthesize(sentence, engine_speed, cancel))
                if cancel.is_set():
                    break
                if not pcm:
                    continue
                if stretch > 1.01:
                    pcm = atempo(pcm, engine.rate, stretch)
                if self.watchers:
                    schedule_words(events, uid, sentence, offset, index,
                                   len(sentences), queued, pcm, engine.rate, lang)
                if not write_paced(pcm, hold=True):
                    cancel.set()
                    break
            # A very short utterance may never have crossed the pre-buffer
            # threshold; let what there is play.
            if not cancel.is_set() and clock["start"] is None and pending:
                if not write_paced(b""):
                    cancel.set()
            if not cancel.is_set():
                # Let the playback clock catch up before closing the sink so
                # the emitter delivers the tail events; pw-play plays out its
                # buffered audio during this wait, so nothing gets longer.
                # The consumption check extends the wait over any stall, with
                # a hard cap in case the sink died silently.
                patience = time.monotonic() + queued + 10
                while clock["start"] is not None and not cancel.is_set():
                    remaining = clock["start"] + queued - time.monotonic()
                    if remaining > 0:
                        cancel.wait(min(remaining, 0.2))
                        continue
                    played = player.consumed_seconds()
                    if played is None or played >= queued or time.monotonic() > patience:
                        break
                    cancel.wait(0.1)
            if not cancel.is_set():
                player.finish()
        except Exception as exc:  # noqa: BLE001
            log(f"speak error: {exc}")
        finally:
            if player is not None:
                player.kill()
            events.put(None)
            if emitter is not None:
                # A finished utterance has already played every scheduled
                # event; the stop flag only frees an emitter that never saw
                # playback start.
                emitter.join(timeout=2)
                emitter_stop.set()
            self.emit({"event": "end", "id": uid})
            with self.lock:
                if self.utterance_id == uid and not cancel.is_set():
                    self.player = None
                    self.worker = None
                    self.set_state("idle")
            with self.done:
                self.done.notify_all()

    def wait_for(self, uid: int, hangup: threading.Event):
        """Block until utterance uid is finished or the client hangs up."""
        while True:
            with self.lock:
                active = self.utterance_id == uid and self.worker is not None and self.worker.is_alive()
            if not active:
                return
            if hangup.is_set():
                log(f"client hung up during utterance {uid}; stopping")
                worker = None
                with self.lock:
                    if self.utterance_id == uid:
                        worker = self._cancel_locked()
                if worker is not None and worker.is_alive():
                    worker.join(timeout=2)
                return
            with self.done:
                self.done.wait(timeout=0.2)

    # -- socket ------------------------------------------------------------

    def handle(self, conn: socket.socket):
        with conn:
            try:
                data = b""
                while not data.endswith(b"\n"):
                    chunk = conn.recv(65536)
                    if not chunk:
                        break
                    data += chunk
                    if len(data) > 4_000_000:
                        break
                req = json.loads(data.decode("utf-8", "replace") or "{}")
            except Exception as exc:  # noqa: BLE001
                self.send(conn, {"ok": False, "error": f"bad request: {exc}"})
                return

            cmd = req.get("cmd")
            if cmd == "speak":
                reply = self.speak(req.get("text", ""), req.get("lang", "auto"), req.get("speed"))
                if reply.get("ok") and req.get("wait"):
                    hangup = threading.Event()

                    def watch():
                        try:
                            while conn.recv(1):
                                pass
                        except Exception:  # noqa: BLE001
                            pass
                        hangup.set()

                    threading.Thread(target=watch, daemon=True).start()
                    self.wait_for(reply["id"], hangup)
                    reply["done"] = True
                self.send(conn, reply)
            elif cmd == "stop":
                self.stop()
                self.send(conn, {"ok": True})
            elif cmd == "status":
                self.send(conn, {"ok": True, **self.status()})
            elif cmd == "set":
                if "speed" in req:
                    speed = max(0.5, min(SPEED_MAX, float(req["speed"])))
                    self.config["tts"]["speed"] = speed
                    STATE_HOME.mkdir(parents=True, exist_ok=True)
                    (STATE_HOME / "speed").write_text(f"{speed:.2f}\n")
                if "highlight_delay" in req:
                    # Applied live, mid-utterance: the emitter reads it per
                    # event, so the user can tune sync by ear while reading.
                    delay = max(-0.3, min(1.5, float(req["highlight_delay"])))
                    self.config["tts"]["highlight_delay"] = delay
                    STATE_HOME.mkdir(parents=True, exist_ok=True)
                    (STATE_HOME / "highlight-delay").write_text(f"{delay:.2f}\n")
                self.send(conn, {"ok": True, **self.status()})
            elif cmd == "reload":
                self.reload()
                self.send(conn, {"ok": True, **self.status()})
            elif cmd == "watch":
                conn.settimeout(1.0)
                # A bar-mode client needs the word timing but no on-screen
                # boxes; with no box watcher the locate work is skipped.
                entry = (conn, req.get("boxes", True) is not False)
                with self.watch_lock:
                    self.watchers.append(entry)
                self.send(conn, {"ok": True, "event": "hello", **self.status()})
                # A watcher joining mid-utterance still gets the boxes.
                with self.lock:
                    speaking = self.worker is not None and self.worker.is_alive()
                    boxes = self.current.get("boxes") if speaking else None
                if boxes:
                    self.send(conn, boxes)
                try:
                    # Sit on the connection until the watcher hangs up; the
                    # timeout only exists so a dead peer is noticed.
                    while True:
                        try:
                            if not conn.recv(4096):
                                break
                        except socket.timeout:
                            continue
                        except OSError:
                            break
                finally:
                    with self.watch_lock:
                        if entry in self.watchers:
                            self.watchers.remove(entry)
            else:
                self.send(conn, {"ok": False, "error": f"unknown command: {cmd}"})

    @staticmethod
    def send(conn: socket.socket, obj: dict):
        try:
            conn.sendall((json.dumps(obj) + "\n").encode())
        except Exception:  # noqa: BLE001
            pass

    def serve(self):
        RUNTIME.mkdir(parents=True, exist_ok=True)
        if SOCKET_PATH.exists():
            SOCKET_PATH.unlink()
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(str(SOCKET_PATH))
        os.chmod(SOCKET_PATH, 0o600)
        server.listen(8)

        def shutdown(*_):
            self.stop()
            try:
                SOCKET_PATH.unlink()
            except FileNotFoundError:
                pass
            os._exit(0)

        signal.signal(signal.SIGTERM, shutdown)
        signal.signal(signal.SIGINT, shutdown)
        signal.signal(signal.SIGHUP, lambda *_: threading.Thread(target=self.reload, daemon=True).start())

        log(f"omalexia-speakd: listening on {SOCKET_PATH}")
        while True:
            conn, _ = server.accept()
            threading.Thread(target=self.handle, args=(conn,), daemon=True).start()


def main():
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__)
        return
    # Raise the session accessibility flags so applications (browsers,
    # Electron, GTK, Qt) keep their accessibility trees warm; that is what
    # lets omalexia-locate ask a window for its own text and geometry
    # instead of reading pixels. Best effort; harmless where unsupported.
    for prop in ("IsEnabled", "ScreenReaderEnabled"):
        try:
            subprocess.run(["busctl", "--user", "set-property", "org.a11y.Bus",
                            "/org/a11y/bus", "org.a11y.Status", prop, "b", "true"],
                           capture_output=True, timeout=5)
        except Exception:  # noqa: BLE001
            pass
    daemon = Daemon()
    daemon.preload()
    daemon.serve()


if __name__ == "__main__":
    main()
