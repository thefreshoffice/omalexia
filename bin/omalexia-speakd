#!/usr/bin/python3
"""omalexia-speakd: persistent, local text-to-speech daemon.

Keeps the Piper voices loaded in memory so that speech starts within about a
tenth of a second of a request. Listens on a Unix socket in $XDG_RUNTIME_DIR
and plays audio through PipeWire (pw-play). Nothing leaves the machine.

Protocol: one JSON object per line on the socket, one JSON reply per line.

  {"cmd": "speak", "text": "...", "lang": "auto or an ISO code with a configured voice", "wait": false}
  {"cmd": "stop"}
  {"cmd": "status"}
  {"cmd": "set", "speed": 1.2}
  {"cmd": "reload"}

With "wait": true the connection stays open until playback finishes (or the
client hangs up, which cancels playback). Speech Dispatcher uses that mode.

Uses /usr/bin/python3 on purpose: the piper module is installed system-wide
(AUR piper-tts), not in whatever python mise puts first on PATH.
"""

from __future__ import annotations

import json
import os
import re
import signal
import socket
import subprocess
import sys
import threading
import time
import tomllib
from pathlib import Path

HOME = Path.home()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "omalexia"
SOCKET_PATH = RUNTIME / "speakd.sock"
STATE_PATH = RUNTIME / "state"
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "omalexia" / "config.toml"
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "omalexia"
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local" / "share") / "omalexia"
VOICES_DIR = DATA_HOME / "voices"
KOKORO_DIR = DATA_HOME / "kokoro"

DEFAULT_CONFIG = {
    "tts": {
        "speed": 1.0,
        "default_language": "auto",
        "voices": {"en": "en_US-lessac-medium", "nl": "nl_NL-pim-medium"},
        "engines": {},
        "kokoro": {"voice": "af_heart"},
    }
}


def log(*args):
    print(*args, file=sys.stderr, flush=True)


# --------------------------------------------------------------------------
# Configuration
# --------------------------------------------------------------------------


def load_config() -> dict:
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    if CONFIG_PATH.exists():
        try:
            user = tomllib.loads(CONFIG_PATH.read_text())
        except Exception as exc:  # noqa: BLE001
            log(f"config: ignoring unreadable {CONFIG_PATH}: {exc}")
            user = {}
        tts = user.get("tts", {})
        for key in ("speed", "default_language"):
            if key in tts:
                cfg["tts"][key] = tts[key]
        for key in ("voices", "engines", "kokoro"):
            if isinstance(tts.get(key), dict):
                cfg["tts"][key].update(tts[key])
    # A runtime speed override (set via `omalexia say speed`) beats the file.
    speed_file = STATE_HOME / "speed"
    if speed_file.exists():
        try:
            cfg["tts"]["speed"] = float(speed_file.read_text().strip())
        except ValueError:
            pass
    return cfg


# --------------------------------------------------------------------------
# Text preparation
# --------------------------------------------------------------------------

# Language detection: pick among the languages the user has voices for.
# Stage one looks at the script (Cyrillic, Greek, Arabic, ...), which is
# decisive. Stage two scores Latin-script candidates on high-frequency
# function words plus characters that only some orthographies use.

STOPWORDS: dict[str, set[str]] = {k: set(v.split()) for k, v in {
    "en": "the and of to in is it that for you with on are this be as at or was have from not by but we can will all your what into",
    "nl": "de het een en van ik je niet dat die er maar zijn ook voor naar wordt heeft mij hij wij jullie deze omdat wel dan nog aan bij",
    "de": "der die das und ist nicht ein eine ich sie mit auf für von dem den als auch werden wurde über nach durch beim einem einen sind",
    "fr": "le la les des une est et dans que qui pour pas sur avec vous nous ils elle été être cette aux mais donc leur ont",
    "es": "el la los las una es y en que de por para con no se su al como más pero sus este esta son entre",
    "it": "il lo gli le una è che di non per con del della sono anche più come questo questa nella dal degli alla",
    "pt": "o os as um uma é e que não do da em para com por se mais foi são como este esta pelo uns",
    "da": "og det er en at den til ikke med han hun af på var som her også hvad hvor kan skal jeg ind",
    "no": "og det er en at den til ikke med han hun av på var som her også hva hvor kan skal jeg inn",
    "sv": "och det är en att den till inte med han hon av på var som här också vad kan ska jag ett för",
    "fi": "ja on ei se että hän oli mutta kun myös niin tämä ole sitä joka mitä kuin vain jos nyt sen olen",
    "pl": "i w nie się na jest że to z do o jak ale po co dla przez był była jego tym może",
    "cs": "a je se na to že v s nebo jako ale po pro od tak jsem byl bylo jsou už co když jeho",
    "sk": "a je sa na to že v s alebo ako ale po pre od tak som bol bolo sú už čo keď jeho",
    "ro": "și de la în cu nu pe un o este sunt care mai pentru dar din ce sa au fost când după",
    "hu": "a az és nem hogy is egy van volt de ha már csak meg el ki mint még ezt aki mert",
    "tr": "ve bir bu da de için ile ne var yok ama daha çok gibi ben sen biz siz onlar değil kadar",
    "ca": "el la els les una és i que de no per amb del al més com aquest aquesta són també però hi",
    "is": "og að er það ekki en við hann hún þau af á var sem hér einnig hvað hvar getur ég um",
    "lv": "un ir nav ka tas šis ar no par uz bet kā tikai arī jau vēl kad viņš viņa mēs es",
    "lb": "an dat ass net een eng vun mat fir op och nach wéi mee dass hien si mir dir ech",
    "cy": "y yr a i o yn ac mae ar am gyda ddim wedi bod fel ond hyn nhw chi ni eu",
    "sw": "na ya wa ni kwa la za katika hii yake wake kama lakini pia sana tu baada kabla watu wengi",
    "vi": "và của là không có được cho một người này đã với các những khi tôi bạn chúng để về",
}.items()}

# Characters that strongly suggest one orthography over its neighbours.
CHAR_MARKERS: dict[str, str] = {
    "de": "ßäöü", "es": "ñ¿¡", "pt": "ãõç", "fr": "çàèêëœù", "it": "àèìòù",
    "da": "øå", "no": "øå", "sv": "åäö", "fi": "äö",
    "pl": "ąęłżźśćń", "cs": "řěů", "sk": "ľĺŕô", "hu": "őű",
    "ro": "ășțţâî", "tr": "ğşıİ", "is": "þðæ", "lv": "āēīūķļņģš",
    "ca": "çàèò·", "cy": "ŵŷ", "vi": "ạảấầẩậắằẳẵặẹẻẽếềểễệịọỏốồổỗộớờởỡợụủứừửữựỳỵỷỹđơư",
}

# Non-Latin scripts are decisive on their own.
SCRIPT_RANGES = [
    ((0x4E00, 0x9FFF), "zh"), ((0x3040, 0x30FF), "ja"), ((0xAC00, 0xD7AF), "ko"),
    ((0x10A0, 0x10FF), "ka"), ((0x0370, 0x03FF), "el"),
    ((0x0600, 0x06FF), "ar"), ((0x0400, 0x04FF), "ru"),
    ((0x0900, 0x097F), "hi"), ((0x0590, 0x05FF), "he"),
    ((0x0530, 0x058F), "hy"), ((0x0980, 0x09FF), "bn"),
    ((0x0C00, 0x0C7F), "te"), ((0x0D00, 0x0D7F), "ml"),
]


def _script_language(text: str, candidates: list[str]) -> str | None:
    counts: dict[str, int] = {}
    for ch in text:
        cp = ord(ch)
        if cp < 0x0370:
            continue
        for (lo, hi), lang in SCRIPT_RANGES:
            if lo <= cp <= hi:
                counts[lang] = counts.get(lang, 0) + 1
                break
    if not counts:
        return None
    lang = max(counts, key=counts.get)
    if counts[lang] < 3:
        return None
    # Han plus kana means Japanese, not Chinese.
    if lang == "zh" and counts.get("ja") and "ja" in candidates:
        lang = "ja"
    # Cyrillic with Bulgarian in play and no Russian: prefer the candidate.
    if lang == "ru" and "ru" not in candidates and "bg" in candidates:
        lang = "bg"
    # Refine within a shared script.
    if lang == "ar":
        if "fa" in candidates and ("ar" not in candidates or any(c in text for c in "پچژگ")):
            lang = "fa"
        elif "ur" in candidates and ("ar" not in candidates or any(c in text for c in "ٹڈڑںھے")):
            lang = "ur"
    if lang == "ru":
        if "uk" in candidates and any(c in text for c in "іїєґ"):
            lang = "uk"
        elif "kk" in candidates and any(c in text for c in "әғқңөұүһ"):
            lang = "kk"
        elif "sr" in candidates and any(c in text for c in "ђћџљњ"):
            lang = "sr"
        elif "ru" not in candidates:
            lang = next((c for c in ("uk", "sr", "kk") if c in candidates), lang)
    if lang == "hi" and "hi" not in candidates and "ne" in candidates:
        lang = "ne"
    return lang if lang in candidates else None


def detect_language(text: str, fallback: str, candidates: list[str]) -> str:
    if not candidates:
        return fallback
    if fallback not in candidates:
        fallback = candidates[0]
    if len(candidates) == 1:
        return candidates[0]
    by_script = _script_language(text, candidates)
    if by_script:
        return by_script
    lowered = text.lower()
    words = re.findall(r"[^\W\d_]+", lowered, re.UNICODE)
    if not words:
        return fallback
    scores: dict[str, int] = {}
    for lang in candidates:
        score = sum(2 for w in words if w in STOPWORDS.get(lang, ()))
        markers = CHAR_MARKERS.get(lang)
        if markers:
            score += min(sum(lowered.count(c) for c in markers), len(words) // 2)
        # Legacy tie-breakers that work well for the common en/nl pair.
        if lang == "nl":
            score += sum(1 for w in words if "ij" in w) // 2
        if lang == "en":
            score += sum(1 for w in words if w.startswith("th")) // 2
        scores[lang] = score
    best = max(scores, key=scores.get)
    ranked = sorted(scores.values(), reverse=True)
    if ranked[0] == 0 or (len(ranked) > 1 and ranked[0] == ranked[1]):
        return fallback
    return best


URL_RE = re.compile(r"https?://(?:www\.)?([^/\s]+)\S*")
BULLET_RE = re.compile(r"^\s*(?:[-*•▪◦]|\d+[.)])\s+", re.MULTILINE)
HEADING_RE = re.compile(r"^\s*#{1,6}\s+", re.MULTILINE)


def prepare_text(text: str) -> str:
    """Make copied text read well aloud: unwrap hard line breaks, drop
    markdown noise, read URLs as their host name."""
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = URL_RE.sub(r"\1", text)
    text = HEADING_RE.sub("", text)
    text = BULLET_RE.sub("", text)
    text = re.sub(r"[*_`>#|]+", " ", text)
    lines = [ln.rstrip() for ln in text.split("\n")]
    out: list[str] = []
    for ln in lines:
        if not ln.strip():
            # Paragraph break: make sure the previous sentence closes.
            if out and not re.search(r"[.!?:;…]$", out[-1]):
                out[-1] += "."
            continue
        if out and not re.search(r"[.!?:;…]$", out[-1]) and not out[-1].endswith("\n"):
            out[-1] = out[-1] + " " + ln.strip()
        else:
            out.append(ln.strip())
    text = " ".join(out)
    text = re.sub(r"\s+", " ", text).strip()
    return text


SENTENCE_RE = re.compile(r"(?<=[.!?…])\s+")
ABBREVIATIONS = {
    "mr", "mrs", "ms", "dr", "prof", "st", "vs", "etc", "nr", "no", "ca", "approx",
    "dhr", "mevr", "mw", "bv", "o.a", "d.w.z", "e.g", "i.e", "z.b", "bzw", "u.a",
}


def split_sentences(text: str) -> list[str]:
    """Split prepared text into sentences so the daemon can re-read the speed
    between them. Boundaries the engines would find themselves; a wrong split
    only shortens one synthesis call."""
    parts: list[str] = []
    start = 0
    for m in SENTENCE_RE.finditer(text):
        before = text[start:m.start()].rstrip()
        word = before.rsplit(None, 1)[-1] if before else ""
        bare = word.rstrip(".!?…").lower()
        nxt = text[m.end(): m.end() + 1]
        # Not a boundary: known abbreviation, an initial ("J."), or the next
        # word continues in lowercase.
        if bare in ABBREVIATIONS or (len(bare) == 1 and bare.isalpha()) or (nxt and nxt.islower()):
            continue
        if before:
            parts.append(text[start:m.start()].strip())
        start = m.end()
    tail = text[start:].strip()
    if tail:
        parts.append(tail)
    # Glue fragments that are too short to synthesize on their own.
    merged: list[str] = []
    for part in parts:
        if merged and len(part) < 4:
            merged[-1] += " " + part
        else:
            merged.append(part)
    return merged or [text]


# --------------------------------------------------------------------------
# Engines
# --------------------------------------------------------------------------


class PiperEngine:
    name = "piper"

    def __init__(self, voice_name: str):
        from piper import PiperVoice  # imported lazily so --help works without it

        model = VOICES_DIR / f"{voice_name}.onnx"
        if not model.exists():
            raise FileNotFoundError(f"voice not installed: {voice_name} ({model})")
        t = time.time()
        self.voice = PiperVoice.load(str(model))
        self.rate = self.voice.config.sample_rate
        self.voice_name = voice_name
        log(f"piper: loaded {voice_name} in {time.time() - t:.2f}s ({self.rate} Hz)")

    def synthesize(self, text: str, speed: float, cancel: threading.Event):
        from piper import SynthesisConfig

        cfg = SynthesisConfig(length_scale=1.0 / max(0.4, min(2.5, speed)))
        for chunk in self.voice.synthesize(text, cfg):
            if cancel.is_set():
                return
            yield chunk.audio_int16_bytes


class KokoroEngine:
    """Kokoro-82M through a worker process living in its own venv (it needs
    Python 3.12 and its own onnxruntime). English only, higher quality."""

    name = "kokoro"

    def __init__(self, voice: str):
        python = KOKORO_DIR / ".venv" / "bin" / "python"
        worker = KOKORO_DIR / "worker.py"
        if not python.exists() or not worker.exists():
            raise FileNotFoundError("kokoro is not installed (run: omalexia voice install kokoro)")
        self.voice_name = voice
        self.rate = 24000
        self.proc = subprocess.Popen(
            [str(python), str(worker)],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=sys.stderr,
            cwd=KOKORO_DIR,
        )
        self.lock = threading.Lock()
        # Wait for the worker's ready line.
        line = self.proc.stdout.readline()
        if not line.startswith(b"ready"):
            raise RuntimeError("kokoro worker failed to start")
        log(f"kokoro: worker ready ({voice})")

    def synthesize(self, text: str, speed: float, cancel: threading.Event):
        lang = "en-gb" if self.voice_name.startswith("b") else "en-us"
        req = json.dumps({"text": text, "voice": self.voice_name, "speed": speed, "lang": lang})
        with self.lock:
            self.proc.stdin.write(req.encode() + b"\n")
            self.proc.stdin.flush()
            while True:
                header = self.proc.stdout.read(4)
                if len(header) < 4:
                    return
                n = int.from_bytes(header, "little")
                if n == 0:
                    return
                data = self.proc.stdout.read(n)
                if cancel.is_set():
                    # Drain the rest so the worker stays in sync.
                    continue
                yield data


# --------------------------------------------------------------------------
# Player
# --------------------------------------------------------------------------


class Player:
    def __init__(self, rate: int):
        self.proc = subprocess.Popen(
            ["pw-play", "--raw", "--format", "s16", "--rate", str(rate), "--channels", "1",
             "--media-role", "Accessibility", "-"],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    def write(self, data: bytes) -> bool:
        try:
            self.proc.stdin.write(data)
            self.proc.stdin.flush()
            return True
        except (BrokenPipeError, ValueError):
            return False

    def finish(self):
        try:
            self.proc.stdin.close()
        except Exception:  # noqa: BLE001
            pass
        self.proc.wait()

    def kill(self):
        try:
            self.proc.kill()
        except Exception:  # noqa: BLE001
            pass
        try:
            self.proc.stdin.close()
        except Exception:  # noqa: BLE001
            pass


# --------------------------------------------------------------------------
# Daemon
# --------------------------------------------------------------------------


class Daemon:
    def __init__(self):
        self.config = load_config()
        self.engines: dict[str, object] = {}
        self.lock = threading.Lock()
        self.cancel = threading.Event()
        self.worker: threading.Thread | None = None
        self.player: Player | None = None
        self.current: dict = {}
        self.utterance_id = 0
        self.done = threading.Condition()
        self.set_state("idle")

    # -- state -------------------------------------------------------------

    def set_state(self, state: str):
        # Written in place (not atomically renamed) so inotify watchers on
        # the path (the bar plugin, `omalexia-say follow`) keep their watch.
        RUNTIME.mkdir(parents=True, exist_ok=True)
        with open(STATE_PATH, "w") as f:
            f.write(state + "\n")

    def status(self) -> dict:
        speaking = self.worker is not None and self.worker.is_alive()
        return {
            "state": "speaking" if speaking else "idle",
            "speed": self.config["tts"]["speed"],
            "voices": self.config["tts"]["voices"],
            "engines": {lang: getattr(e, "name", "?") for lang, e in self.engines.items()},
            "text": self.current.get("text", "")[:120] if speaking else "",
        }

    # -- engines -----------------------------------------------------------

    MAX_WARM_ENGINES = 3

    def engine_for(self, lang: str):
        if lang in self.engines:
            # Move to the end: most recently used.
            self.engines[lang] = self.engines.pop(lang)
            return self.engines[lang]
        tts = self.config["tts"]
        wanted = tts["engines"].get(lang, "piper")
        engine = None
        if wanted == "kokoro" and lang == "en":
            try:
                engine = KokoroEngine(tts["kokoro"].get("voice", "af_heart"))
            except Exception as exc:  # noqa: BLE001
                log(f"kokoro unavailable, falling back to piper: {exc}")
        if engine is None:
            voice = tts["voices"].get(lang)
            if not voice:
                raise FileNotFoundError(f"no voice configured for language '{lang}'")
            engine = PiperEngine(voice)
        self.engines[lang] = engine
        # With many languages configured, keep only the most recently used
        # voices in memory; never evict the one that is speaking right now.
        active = self.current.get("lang")
        while len(self.engines) > self.MAX_WARM_ENGINES:
            victims = [k for k in self.engines if k not in (lang, active)]
            # A voice with a worker process (Kokoro) is expensive to bring
            # back; evict the in-process Piper voices first.
            victim = next((k for k in victims
                           if getattr(self.engines[k], "proc", None) is None),
                          victims[0] if victims else None)
            if victim is None:
                break
            dropped = self.engines.pop(victim)
            proc = getattr(dropped, "proc", None)
            if proc is not None:
                try:
                    proc.terminate()
                except Exception:  # noqa: BLE001
                    pass
            log(f"unloaded {victim} voice (keeping {self.MAX_WARM_ENGINES} warm)")
        return engine

    def preload(self):
        """Warm the most likely voices; the rest load on first use (~1 s)."""
        tts = self.config["tts"]
        langs = list(tts["voices"])
        default = tts["default_language"]
        if default in langs:
            langs.remove(default)
            langs.insert(0, default)
        for lang in langs[: self.MAX_WARM_ENGINES]:
            try:
                self.engine_for(lang)
            except Exception as exc:  # noqa: BLE001
                log(f"preload {lang}: {exc}")

    def reload(self):
        self.stop()
        with self.lock:
            old_tts = self.config["tts"]
            self.config = load_config()
            tts = self.config["tts"]
            kept: dict[str, object] = {}
            for lang, engine in self.engines.items():
                unchanged = (
                    lang in tts["voices"]
                    and tts["voices"].get(lang) == old_tts["voices"].get(lang)
                    and tts["engines"].get(lang, "piper") == old_tts["engines"].get(lang, "piper")
                    and (tts["engines"].get(lang) != "kokoro" or tts["kokoro"] == old_tts["kokoro"])
                )
                if unchanged:
                    kept[lang] = engine
                    continue
                proc = getattr(engine, "proc", None)
                if proc is not None:
                    proc.kill()
                log(f"reload: dropping {lang} voice (configuration changed)")
            self.engines = kept
        self.preload()

    # -- speaking ----------------------------------------------------------

    def _cancel_locked(self) -> threading.Thread | None:
        """Cancel the current utterance. Must be called with the lock held;
        returns the old worker so the caller can join it *outside* the lock
        (the worker needs the lock to finish)."""
        self.cancel.set()
        if self.player is not None:
            self.player.kill()
        worker = self.worker
        self.worker = None
        self.player = None
        self.cancel = threading.Event()
        self.set_state("idle")
        return worker

    def stop(self):
        with self.lock:
            worker = self._cancel_locked()
        if worker is not None and worker.is_alive():
            worker.join(timeout=2)

    def speak(self, text: str, lang: str, speed: float | None = None) -> dict:
        text = prepare_text(text)
        if not text:
            return {"ok": False, "error": "nothing to read"}
        tts = self.config["tts"]
        if lang in ("", "auto", None):
            fallback = tts["default_language"] if tts["default_language"] != "auto" else "en"
            lang = detect_language(text, fallback, list(tts["voices"]))
        if lang not in tts["voices"]:
            lang = next(iter(tts["voices"]))
        try:
            engine = self.engine_for(lang)
        except Exception as exc:  # noqa: BLE001
            return {"ok": False, "error": str(exc)}

        with self.lock:
            old = self._cancel_locked()
            self.utterance_id += 1
            uid = self.utterance_id
            cancel = self.cancel
            self.current = {"text": text, "lang": lang, "id": uid}
            # No explicit speed: follow the live setting, re-read between
            # sentences so `set` changes apply mid-text.
            if speed is not None:
                speed = max(0.5, min(2.5, float(speed)))
            thread = threading.Thread(
                target=self._run, args=(engine, text, speed, cancel, uid), daemon=True
            )
            self.worker = thread
            self.set_state("speaking")
            thread.start()
        if old is not None and old.is_alive():
            old.join(timeout=2)
        return {"ok": True, "id": uid, "lang": lang, "engine": engine.name, "chars": len(text)}

    def _run(self, engine, text: str, speed: float | None, cancel: threading.Event, uid: int):
        player = None
        try:
            player = Player(engine.rate)
            with self.lock:
                if cancel.is_set():
                    player.kill()
                    return
                self.player = player
            last_speed = None
            for sentence in split_sentences(text):
                if cancel.is_set():
                    break
                now = speed if speed is not None else float(self.config["tts"]["speed"])
                if last_speed is not None and now != last_speed:
                    log(f"speed {last_speed} -> {now} mid-utterance")
                last_speed = now
                for pcm in engine.synthesize(sentence, now, cancel):
                    if cancel.is_set() or not player.write(pcm):
                        cancel.set()
                        break
            if not cancel.is_set():
                player.finish()
        except Exception as exc:  # noqa: BLE001
            log(f"speak error: {exc}")
        finally:
            if player is not None:
                player.kill()
            with self.lock:
                if self.utterance_id == uid and not cancel.is_set():
                    self.player = None
                    self.worker = None
                    self.set_state("idle")
            with self.done:
                self.done.notify_all()

    def wait_for(self, uid: int, hangup: threading.Event):
        """Block until utterance uid is finished or the client hangs up."""
        while True:
            with self.lock:
                active = self.utterance_id == uid and self.worker is not None and self.worker.is_alive()
            if not active:
                return
            if hangup.is_set():
                log(f"client hung up during utterance {uid}; stopping")
                worker = None
                with self.lock:
                    if self.utterance_id == uid:
                        worker = self._cancel_locked()
                if worker is not None and worker.is_alive():
                    worker.join(timeout=2)
                return
            with self.done:
                self.done.wait(timeout=0.2)

    # -- socket ------------------------------------------------------------

    def handle(self, conn: socket.socket):
        with conn:
            try:
                data = b""
                while not data.endswith(b"\n"):
                    chunk = conn.recv(65536)
                    if not chunk:
                        break
                    data += chunk
                    if len(data) > 4_000_000:
                        break
                req = json.loads(data.decode("utf-8", "replace") or "{}")
            except Exception as exc:  # noqa: BLE001
                self.send(conn, {"ok": False, "error": f"bad request: {exc}"})
                return

            cmd = req.get("cmd")
            if cmd == "speak":
                reply = self.speak(req.get("text", ""), req.get("lang", "auto"), req.get("speed"))
                if reply.get("ok") and req.get("wait"):
                    hangup = threading.Event()

                    def watch():
                        try:
                            while conn.recv(1):
                                pass
                        except Exception:  # noqa: BLE001
                            pass
                        hangup.set()

                    threading.Thread(target=watch, daemon=True).start()
                    self.wait_for(reply["id"], hangup)
                    reply["done"] = True
                self.send(conn, reply)
            elif cmd == "stop":
                self.stop()
                self.send(conn, {"ok": True})
            elif cmd == "status":
                self.send(conn, {"ok": True, **self.status()})
            elif cmd == "set":
                if "speed" in req:
                    speed = max(0.5, min(2.5, float(req["speed"])))
                    self.config["tts"]["speed"] = speed
                    STATE_HOME.mkdir(parents=True, exist_ok=True)
                    (STATE_HOME / "speed").write_text(f"{speed:.2f}\n")
                self.send(conn, {"ok": True, **self.status()})
            elif cmd == "reload":
                self.reload()
                self.send(conn, {"ok": True, **self.status()})
            else:
                self.send(conn, {"ok": False, "error": f"unknown command: {cmd}"})

    @staticmethod
    def send(conn: socket.socket, obj: dict):
        try:
            conn.sendall((json.dumps(obj) + "\n").encode())
        except Exception:  # noqa: BLE001
            pass

    def serve(self):
        RUNTIME.mkdir(parents=True, exist_ok=True)
        if SOCKET_PATH.exists():
            SOCKET_PATH.unlink()
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(str(SOCKET_PATH))
        os.chmod(SOCKET_PATH, 0o600)
        server.listen(8)

        def shutdown(*_):
            self.stop()
            try:
                SOCKET_PATH.unlink()
            except FileNotFoundError:
                pass
            os._exit(0)

        signal.signal(signal.SIGTERM, shutdown)
        signal.signal(signal.SIGINT, shutdown)
        signal.signal(signal.SIGHUP, lambda *_: threading.Thread(target=self.reload, daemon=True).start())

        log(f"omalexia-speakd: listening on {SOCKET_PATH}")
        while True:
            conn, _ = server.accept()
            threading.Thread(target=self.handle, args=(conn,), daemon=True).start()


def main():
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__)
        return
    daemon = Daemon()
    daemon.preload()
    daemon.serve()


if __name__ == "__main__":
    main()
