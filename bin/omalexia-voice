#!/usr/bin/python3
"""omalexia-voice: manage the local reading voices.

Usage:
  omalexia-voice list                       installed voices and the current choice
  omalexia-voice languages                  languages: enabled, and available for download
  omalexia-voice add [LANG [VOICE]]         enable a language (downloads a good default voice)
  omalexia-voice remove LANG                disable a language (keeps the files)
  omalexia-voice catalog [LANG]             voices available for download
  omalexia-voice install NAME [NAME...]     download Piper voices (e.g. nl_NL-pim-medium)
  omalexia-voice install kokoro             install the optional Kokoro English engine
  omalexia-voice set LANG NAME              use NAME for that language (installs it if needed)
  omalexia-voice engine en piper|kokoro     pick the English engine
  omalexia-voice language auto|LANG         default when the language cannot be detected
  omalexia-voice test [LANG]                say a test sentence

Reading works in any language with a Piper voice (about 35). `add de` is all
it takes; the daemon detects the language of the text among the enabled ones.

Voices live in ~/.local/share/omalexia/voices; settings in
~/.config/omalexia/config.toml. The daemon reloads automatically.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import tomllib
import urllib.request
from pathlib import Path

HOME = Path.home()
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "omalexia"
CONFIG_PATH = CONFIG_DIR / "config.toml"
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local" / "share") / "omalexia"
VOICES_DIR = DATA_HOME / "voices"
KOKORO_DIR = DATA_HOME / "kokoro"
KOKORO_FILES = {
    "kokoro-v1.0.onnx": "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx",
    "voices-v1.0.bin": "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin",
}
VOICES_INDEX = "https://huggingface.co/rhasspy/piper-voices/resolve/main/voices.json"

# Curated, single-speaker voices that read clearly. Anything in the Piper
# catalog works too (omalexia-voice catalog).
RECOMMENDED = {
    "en": [
        ("en_US-lessac-medium", "clear US English, instant (default)"),
        ("en_GB-alan-medium", "clear British English, instant"),
        ("en_GB-jenny_dioco-medium", "warm British English, instant"),
        ("en_US-hfc_female-medium", "bright US English, instant"),
        ("en_US-lessac-high", "richer US English, ~1 s to start"),
        ("en_GB-cori-high", "richer British English, ~1 s to start"),
    ],
    "nl": [
        ("nl_NL-pim-medium", "clear Dutch, instant (default)"),
        ("nl_NL-ronnie-medium", "Dutch, instant"),
        ("nl_NL-alex-medium", "Dutch, instant"),
        ("nl_BE-nathalie-medium", "Flemish, instant"),
        ("nl_BE-rdh-medium", "Flemish, instant"),
    ],
}

# Language names for the selector, and the voice `add` picks by default.
# Anything else in the Piper catalog still works via `set LANG NAME`.
LANG_NAMES = {
    "ar": "العربية (Arabic)", "ca": "Català", "cs": "Čeština", "cy": "Cymraeg",
    "da": "Dansk", "de": "Deutsch", "el": "Ελληνικά", "en": "English",
    "es": "Español", "fa": "فارسی (Persian)", "fi": "Suomi", "fr": "Français",
    "hi": "हिन्दी (Hindi)", "hu": "Magyar", "is": "Íslenska", "it": "Italiano",
    "ka": "ქართული (Georgian)", "kk": "Қазақша", "lb": "Lëtzebuergesch",
    "lv": "Latviešu", "ne": "नेपाली (Nepali)", "nl": "Nederlands",
    "no": "Norsk", "pl": "Polski", "pt": "Português", "ro": "Română",
    "ru": "Русский", "sk": "Slovenčina", "sl": "Slovenščina", "sr": "Српски",
    "sv": "Svenska", "sw": "Kiswahili", "tr": "Türkçe", "uk": "Українська",
    "vi": "Tiếng Việt", "zh": "中文 (Chinese)", "bg": "Български", "bn": "বাংলা (Bengali)",
    "eu": "Euskara", "he": "עברית (Hebrew)", "hy": "Հայերեն (Armenian)",
    "id": "Bahasa Indonesia", "ja": "日本語 (Japanese)", "ko": "한국어 (Korean)",
    "ku": "Kurdî", "ml": "മലയാളം (Malayalam)", "mr": "मराठी (Marathi)",
    "sq": "Shqip", "te": "తెలుగు (Telugu)", "ur": "اردو (Urdu)",
}
PREFERRED_VOICE = {
    "en": "en_US-lessac-medium", "nl": "nl_NL-pim-medium",
    "de": "de_DE-thorsten-medium", "fr": "fr_FR-siwis-medium",
    "es": "es_ES-davefx-medium", "it": "it_IT-paola-medium",
    "sv": "sv_SE-nst-medium", "ru": "ru_RU-irina-medium",
    "uk": "uk_UA-ukrainian_tts-medium", "pl": "pl_PL-darkman-medium",
    "tr": "tr_TR-dfki-medium", "zh": "zh_CN-huayan-medium",
}
QUALITY_ORDER = {"medium": 0, "high": 1, "low": 2, "x_low": 3}

TEST_SENTENCES = {
    "en": "Hello, I am the Omalexia voice. Select some text and press F10 to hear it read aloud.",
    "nl": "Hallo, ik ben de stem van Omalexia. Selecteer tekst en druk op F10 om het voor te lezen.",
    "de": "Hallo, ich bin die Stimme von Omalexia. Markiere einen Text und drücke F10, um ihn vorlesen zu lassen.",
    "fr": "Bonjour, je suis la voix d'Omalexia. Sélectionnez un texte et appuyez sur F10 pour l'écouter.",
    "es": "Hola, soy la voz de Omalexia. Selecciona un texto y pulsa F10 para escucharlo.",
    "it": "Ciao, sono la voce di Omalexia. Seleziona un testo e premi F10 per ascoltarlo.",
    "pt": "Olá, sou a voz do Omalexia. Selecione um texto e pressione F10 para o ouvir.",
    "sv": "Hej, jag är Omalexias röst. Markera en text och tryck på F10 för att höra den uppläst.",
    "pl": "Cześć, jestem głosem Omalexii. Zaznacz tekst i naciśnij F10, aby go odsłuchać.",
    "ru": "Привет, я голос Омалексии. Выделите текст и нажмите F10, чтобы прослушать его.",
}

DEFAULTS = {
    "tts": {
        "speed": 1.0,
        "default_language": "auto",
        "voices": {"en": "en_US-lessac-medium", "nl": "nl_NL-pim-medium"},
        "engines": {},
        "kokoro": {"voice": "af_heart"},
    }
}


def load() -> dict:
    cfg = json.loads(json.dumps(DEFAULTS))
    if CONFIG_PATH.exists():
        user = tomllib.loads(CONFIG_PATH.read_text()).get("tts", {})
        for k in ("speed", "default_language"):
            if k in user:
                cfg["tts"][k] = user[k]
        for k in ("voices", "engines", "kokoro"):
            if isinstance(user.get(k), dict):
                cfg["tts"][k].update(user[k])
    return cfg


def toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    return json.dumps(str(v))


def save(cfg: dict):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tts = cfg["tts"]
    lines = [
        "# Omalexia text-to-speech settings. Managed by `omalexia voice`; hand edits are fine.",
        "[tts]",
        f"speed = {toml_value(tts['speed'])}",
        f"default_language = {toml_value(tts['default_language'])}",
        "",
        "[tts.voices]",
    ]
    lines += [f"{k} = {toml_value(v)}" for k, v in tts["voices"].items()]
    lines += ["", "[tts.engines]"]
    lines += [f"{k} = {toml_value(v)}" for k, v in tts["engines"].items()]
    lines += ["", "[tts.kokoro]"]
    lines += [f"{k} = {toml_value(v)}" for k, v in tts["kokoro"].items()]
    CONFIG_PATH.write_text("\n".join(lines) + "\n")
    reload_daemon()


def reload_daemon():
    subprocess.run(["systemctl", "--user", "reload-or-restart", "omalexia-speakd.service"],
                   check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def installed() -> list[str]:
    return sorted(p.stem for p in VOICES_DIR.glob("*.onnx") if p.with_suffix(".onnx.json").exists())


def install_piper(names: list[str]) -> bool:
    VOICES_DIR.mkdir(parents=True, exist_ok=True)
    missing = [n for n in names if n not in installed()]
    if not missing:
        return True
    print(f"Downloading {', '.join(missing)} …")
    result = subprocess.run(
        ["/usr/bin/python3", "-m", "piper.download_voices", "--download-dir", str(VOICES_DIR), *missing],
        check=False,
    )
    return result.returncode == 0 and all(n in installed() for n in missing)


def install_kokoro() -> bool:
    KOKORO_DIR.mkdir(parents=True, exist_ok=True)
    venv = KOKORO_DIR / ".venv"
    worker_src = Path(os.environ.get("OMALEXIA_KOKORO_WORKER") or DATA_HOME / "kokoro-worker.py")
    if not worker_src.exists():
        print("kokoro worker script not found; reinstall omalexia", file=sys.stderr)
        return False
    (KOKORO_DIR / "worker.py").write_text(worker_src.read_text())
    if not (venv / "bin" / "python").exists():
        uv = subprocess.run(["which", "uv"], capture_output=True, check=False).returncode == 0
        if uv:
            cmd = ["uv", "venv", "--python", "3.12", str(venv)]
        else:
            cmd = ["python3", "-m", "venv", str(venv)]
        if subprocess.run(cmd, check=False).returncode != 0:
            return False
    pip = ["uv", "pip", "install", "--python", str(venv / "bin" / "python")] if subprocess.run(
        ["which", "uv"], capture_output=True, check=False).returncode == 0 else [str(venv / "bin" / "pip"), "install"]
    if subprocess.run([*pip, "kokoro-onnx", "numpy"], check=False).returncode != 0:
        return False
    for name, url in KOKORO_FILES.items():
        target = KOKORO_DIR / name
        if target.exists():
            continue
        print(f"Downloading {name} …")
        urllib.request.urlretrieve(url, target)
    print("Kokoro installed. Enable it with: omalexia voice engine en kokoro")
    return True


def fetch_catalog() -> dict | None:
    try:
        with urllib.request.urlopen(VOICES_INDEX, timeout=20) as resp:
            return json.load(resp)
    except Exception as exc:  # noqa: BLE001
        print(f"could not fetch the voice catalog: {exc}", file=sys.stderr)
        return None


def catalog_by_family(data: dict) -> dict[str, list[str]]:
    families: dict[str, list[str]] = {}
    for key, v in data.items():
        code = v.get("language", {}).get("code", "")
        fam = v.get("language", {}).get("family") or code.split("_")[0]
        if fam:
            families.setdefault(fam, []).append(key)
    return families


def default_voice_for(lang: str, data: dict) -> str | None:
    if lang in PREFERRED_VOICE and PREFERRED_VOICE[lang] in data:
        return PREFERRED_VOICE[lang]
    names = catalog_by_family(data).get(lang, [])
    if not names:
        return None
    return sorted(names, key=lambda n: (QUALITY_ORDER.get(n.rsplit("-", 1)[-1], 9), n))[0]


def print_languages(cfg: dict, families: dict[str, list[str]] | None):
    tts = cfg["tts"]
    print("Enabled (the daemon detects among these):")
    for lang, name in tts["voices"].items():
        label = LANG_NAMES.get(lang, lang)
        print(f"  {lang:4} {label:28} {name}")
    if families is None:
        return
    print("Available (omalexia voice add LANG):")
    for fam in sorted(families):
        if fam in tts["voices"]:
            continue
        label = LANG_NAMES.get(fam, fam)
        print(f"  {fam:4} {label:28} {len(families[fam])} voice(s)")


def add_language(cfg: dict, lang: str | None, voice: str | None) -> int:
    data = fetch_catalog()
    if data is None:
        return 1
    families = catalog_by_family(data)
    if not lang:
        print_languages(cfg, families)
        try:
            lang = input("Language code to add (empty to cancel): ").strip()
        except EOFError:
            lang = ""
        if not lang:
            return 0
    lang = lang.lower()
    if lang not in families:
        print(f"no Piper voices for '{lang}'; see: omalexia voice languages", file=sys.stderr)
        return 1
    name = voice or default_voice_for(lang, data)
    if name is None or not install_piper([name]):
        print(f"could not install a voice for {lang}", file=sys.stderr)
        return 1
    cfg["tts"]["voices"][lang] = name
    save(cfg)
    print(f"{LANG_NAMES.get(lang, lang)} enabled with {name}. Others: omalexia voice catalog {lang}")
    return 0


def remove_language(cfg: dict, lang: str) -> int:
    tts = cfg["tts"]
    if lang not in tts["voices"]:
        print(f"{lang} is not enabled", file=sys.stderr)
        return 1
    if len(tts["voices"]) == 1:
        print("refusing to remove the last language", file=sys.stderr)
        return 1
    del tts["voices"][lang]
    tts["engines"].pop(lang, None)
    if tts["default_language"] == lang:
        tts["default_language"] = "auto"
    save(cfg)
    print(f"{lang} disabled (voice files kept in {VOICES_DIR})")
    return 0


def catalog(lang: str | None):
    data = fetch_catalog()
    if data is None:
        return 1
    for key, v in sorted(data.items()):
        code = v.get("language", {}).get("code", "")
        if lang and not code.lower().startswith(lang.lower()):
            continue
        print(f"{key:36} {v.get('quality', ''):7} {v.get('language', {}).get('name_english', '')}")
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    cfg = load()
    tts = cfg["tts"]

    if cmd == "list":
        have = installed()
        print("Current:")
        for lang, name in tts["voices"].items():
            engine = tts["engines"].get(lang, "piper")
            mark = "" if name in have else "  (not installed)"
            print(f"  {lang}: {name} [{engine}]{mark}")
        print(f"  default language: {tts['default_language']}, speed: {tts['speed']}")
        print("Installed:")
        for name in have:
            print(f"  {name}")
        print("Recommended:")
        for lang, voices in RECOMMENDED.items():
            for name, blurb in voices:
                print(f"  {lang}: {name:28} {blurb}")
        if (KOKORO_DIR / ".venv").exists():
            print("Kokoro: installed")
        return 0

    if cmd == "languages":
        print_languages(cfg, None if rest == ["--offline"] else (
            catalog_by_family(d) if (d := fetch_catalog()) else None))
        return 0

    if cmd == "add":
        return add_language(cfg, rest[0] if rest else None, rest[1] if len(rest) > 1 else None)

    if cmd == "remove" and len(rest) == 1:
        return remove_language(cfg, rest[0])

    if cmd == "catalog":
        return catalog(rest[0] if rest else None)

    if cmd == "install":
        if not rest:
            print("install what?", file=sys.stderr)
            return 1
        if rest == ["kokoro"]:
            return 0 if install_kokoro() else 1
        return 0 if install_piper(rest) else 1

    if cmd == "set" and len(rest) == 2:
        lang, name = rest
        if not install_piper([name]):
            print(f"could not install {name}", file=sys.stderr)
            return 1
        tts["voices"][lang] = name
        save(cfg)
        print(f"{lang} -> {name}")
        return 0

    if cmd == "engine" and len(rest) == 2:
        lang, engine = rest
        if engine not in ("piper", "kokoro"):
            print("engine must be piper or kokoro", file=sys.stderr)
            return 1
        if engine == "kokoro" and lang != "en":
            print("kokoro only speaks English", file=sys.stderr)
            return 1
        if engine == "kokoro" and not (KOKORO_DIR / ".venv").exists():
            if not install_kokoro():
                return 1
        tts["engines"][lang] = engine
        save(cfg)
        print(f"{lang} engine -> {engine}")
        return 0

    if cmd == "language" and len(rest) == 1:
        tts["default_language"] = rest[0]
        save(cfg)
        return 0

    if cmd == "test":
        lang = rest[0] if rest else tts["default_language"]
        if lang in ("auto", "", None):
            lang = next(iter(tts["voices"]), "en")
        text = TEST_SENTENCES.get(lang, TEST_SENTENCES["en"])
        return subprocess.run(["omalexia-say", "--lang", lang, text], check=False).returncode

    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
