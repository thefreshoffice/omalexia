  // omalexia:begin, managed by install.sh, edits between the markers are replaced
  "omalexia": {"icon":"󰗊","label":"Omalexia","aliases":["read","reading","dyslexia","accessibility","a11y"]},
  "omalexia.read": {"icon":"󰕾","label":"Read Aloud"},
  "omalexia.read.selection": {"icon":"󰗊","label":"Read Selection  (F10)","action":"omalexia-say selection"},
  "omalexia.read.clipboard": {"icon":"","label":"Read Clipboard  (Shift+F10)","action":"omalexia-say clipboard"},
  "omalexia.read.screen": {"icon":"󰴑","label":"Read Screen Region  (Ctrl+F10)","action":"omalexia-say ocr"},
  "omalexia.read.stop": {"icon":"󰝛","label":"Stop Reading","when":"[[ $(cat \"$XDG_RUNTIME_DIR/omalexia/state\" 2>/dev/null) == speaking ]]","action":"omalexia-say stop"},
  "omalexia.read.faster": {"icon":"󰓅","label":"Faster  (Super+F10)","action":"omalexia-say speed up"},
  "omalexia.read.slower": {"icon":"󰾆","label":"Slower  (Super+Shift+F10)","action":"omalexia-say speed down"},
  "omalexia.read.normal": {"icon":"󰓛","label":"Normal Speed","action":"omalexia-say speed reset"},
  "omalexia.read.test": {"icon":"󰙃","label":"Test Voice","action":"omalexia-voice test"},
  "omalexia.voice": {"icon":"󰍬","label":"Voice"},
  "omalexia.voice.en-lessac": {"icon":"󰗊","label":"English: Lessac (US)","checked":"grep -q 'en = \"en_US-lessac-medium\"' ~/.config/omalexia/config.toml 2>/dev/null","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia-voice set en en_US-lessac-medium'"},
  "omalexia.voice.en-alan": {"icon":"󰗊","label":"English: Alan (UK)","checked":"grep -q 'en = \"en_GB-alan-medium\"' ~/.config/omalexia/config.toml 2>/dev/null","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia-voice set en en_GB-alan-medium'"},
  "omalexia.voice.en-jenny": {"icon":"󰗊","label":"English: Jenny (UK)","checked":"grep -q 'en = \"en_GB-jenny_dioco-medium\"' ~/.config/omalexia/config.toml 2>/dev/null","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia-voice set en en_GB-jenny_dioco-medium'"},
  "omalexia.voice.en-lessac-high": {"icon":"󰗊","label":"English: Lessac, richer (slower start)","checked":"grep -q 'en = \"en_US-lessac-high\"' ~/.config/omalexia/config.toml 2>/dev/null","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia-voice set en en_US-lessac-high'"},
  "omalexia.voice.nl-pim": {"icon":"󰗊","label":"Nederlands: Pim","checked":"grep -q 'nl = \"nl_NL-pim-medium\"' ~/.config/omalexia/config.toml 2>/dev/null","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia-voice set nl nl_NL-pim-medium'"},
  "omalexia.voice.nl-ronnie": {"icon":"󰗊","label":"Nederlands: Ronnie","checked":"grep -q 'nl = \"nl_NL-ronnie-medium\"' ~/.config/omalexia/config.toml 2>/dev/null","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia-voice set nl nl_NL-ronnie-medium'"},
  "omalexia.voice.nl-nathalie": {"icon":"󰗊","label":"Vlaams: Nathalie","checked":"grep -q 'nl = \"nl_BE-nathalie-medium\"' ~/.config/omalexia/config.toml 2>/dev/null","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia-voice set nl nl_BE-nathalie-medium'"},
  "omalexia.voice.kokoro": {"icon":"󰚩","label":"English: Kokoro (premium, optional)","checked":"grep -q 'en = \"kokoro\"' ~/.config/omalexia/config.toml 2>/dev/null","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia-voice engine en kokoro'"},
  "omalexia.voice.piper": {"icon":"󰗊","label":"English: back to Piper","when":"grep -q 'en = \"kokoro\"' ~/.config/omalexia/config.toml 2>/dev/null","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia-voice engine en piper'"},
  "omalexia.voice.more": {"icon":"󰉉","label":"More Voices (terminal)","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia-voice list; echo; echo \"Install with: omalexia voice set en|nl <name>\"; read -r'"},
  "omalexia.dictation": {"icon":"󰍬","label":"Dictation"},
  "omalexia.dictation.toggle": {"icon":"󰑊","label":"Start / Stop Dictation  (Super+Ctrl+X)","when":"omarchy-cmd-present voxtype","action":"voxtype record toggle"},
  "omalexia.dictation.cancel": {"icon":"󰜺","label":"Cancel Dictation  (Shift+F9)","when":"omarchy-cmd-present voxtype","action":"voxtype record cancel"},
  "omalexia.dictation.model": {"icon":"󰚩","label":"Choose Model","when":"omarchy-cmd-present voxtype","action":"omarchy-voxtype-model"},
  "omalexia.dictation.config": {"icon":"","label":"Configure","when":"omarchy-cmd-present voxtype","action":"omarchy-voxtype-config"},
  "omalexia.dictation.replacements": {"icon":"󰬴","label":"Personal Word List","action":"omarchy-launch-config-editor \"$HOME/.config/omalexia/replacements.txt\""},
  "omalexia.dictation.restart": {"icon":"󰜉","label":"Restart Voxtype","when":"omarchy-cmd-present voxtype","action":"systemctl --user restart voxtype.service"},
  "omalexia.dictation.install": {"icon":"󰉉","label":"Install Voxtype","when":"! omarchy-cmd-present voxtype","action":"omarchy-launch-floating-terminal-with-presentation omarchy-voxtype-install"},
  "omalexia.look": {"icon":"󰈈","label":"Look"},
  "omalexia.look.focus": {"icon":"󰖲","label":"Reading Mode  (Super+R)","action":"omalexia-focus toggle"},
  "omalexia.look.tint": {"icon":"󰖙","label":"Paper Tint  (Super+Shift+R)","checked":"[[ -f \"${XDG_STATE_HOME:-$HOME/.local/state}/omalexia/tint\" ]]","action":"omalexia-tint toggle"},
  "omalexia.look.square": {"icon":"󰆟","label":"Narrow Single Window  (Super+Ctrl+Backspace)","checked":"[[ -f \"$HOME/.local/state/omarchy/toggles/hypr/single-window-aspect-ratio.lua\" ]]","action":"omarchy-hyprland-window-single-square-aspect-toggle"},
  "omalexia.look.motion": {"icon":"󰒲","label":"Reduced Motion","checked":"[[ -f \"${XDG_STATE_HOME:-$HOME/.local/state}/omalexia/reduced-motion\" ]]","action":"omalexia motion toggle"},
  "omalexia.look.font": {"icon":"","label":"Reading Font"},
  "omalexia.look.font.atkinson": {"icon":"","label":"Atkinson Hyperlegible","checked":"[[ $(cat \"${XDG_STATE_HOME:-$HOME/.local/state}/omalexia/font-choice\" 2>/dev/null) == atkinson ]]","action":"omalexia-font atkinson"},
  "omalexia.look.font.opendyslexic": {"icon":"","label":"OpenDyslexic","checked":"[[ $(cat \"${XDG_STATE_HOME:-$HOME/.local/state}/omalexia/font-choice\" 2>/dev/null) == opendyslexic ]]","action":"omalexia-font opendyslexic"},
  "omalexia.look.font.inter": {"icon":"","label":"Inter","checked":"[[ $(cat \"${XDG_STATE_HOME:-$HOME/.local/state}/omalexia/font-choice\" 2>/dev/null) == inter ]]","action":"omalexia-font inter"},
  "omalexia.look.font.reset": {"icon":"󰜉","label":"Omarchy Default","checked":"[[ ! -f \"${XDG_STATE_HOME:-$HOME/.local/state}/omalexia/font-choice\" ]]","action":"omalexia-font reset"},
  "omalexia.look.size": {"icon":"󰬴","label":"Text Size"},
  "omalexia.look.size.12": {"icon":"󰬴","label":"Normal (12)","action":"omarchy-display-text-size 12"},
  "omalexia.look.size.14": {"icon":"󰬴","label":"Comfortable (14)","action":"omarchy-display-text-size 14"},
  "omalexia.look.size.16": {"icon":"󰬴","label":"Large (16)","action":"omarchy-display-text-size 16"},
  "omalexia.look.size.18": {"icon":"󰬴","label":"Extra Large (18)","action":"omarchy-display-text-size 18"},
  "omalexia.look.theme": {"icon":"󰸌","label":"Cream Theme (Flexoki Light)","action":"omarchy-theme-set flexoki-light"},
  "omalexia.keys": {"icon":"","label":"Keys","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia keys; read -r'"},
  "omalexia.status": {"icon":"","label":"Status","action":"omarchy-launch-floating-terminal-with-presentation 'omalexia status; read -r'"},
  // omalexia:end
