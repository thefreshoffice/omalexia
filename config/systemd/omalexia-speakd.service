[Unit]
Description=Omalexia local text-to-speech daemon
Documentation=https://github.com/thefreshoffice/omalexia
After=pipewire.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omalexia-speakd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
Nice=5
# Voices are loaded once and kept in memory (about 150 MB for two voices).
Environment=OMP_NUM_THREADS=4

[Install]
# graphical-session.target, not default.target: the daemon must start after
# Hyprland has exported its session environment, or every helper it spawns
# (hyprctl, grim, wtype) is blind and read-along highlighting dies.
WantedBy=graphical-session.target
